-- Anime Dice Auto-Trade (fixed)
-- One trade: add every item, THEN advance once.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TARGET_NAME = "only1Sherifalt1"

-- { item name (exact casing), quantity }
-- Set qty to what you actually own. Asking for more than you have
-- can make the server silently ignore that item.
local ITEMS = {
	{"Trait Reroll", 1000},
	{"Gems", 1000},
	{"Lucky Spin", 1000},
	{"Luck IV", 1000},
	{"Luck III", 1000},
	{"Luck II", 1000},
	{"Luck I", 1000},
	-- units, e.g. {"Huge Angel", 1},
}

local ADD_DELAY = 0.6 -- raise to 1 if items still get skipped

print("[START] Waiting 3s...")
task.wait(3)

local target = Players:FindFirstChild(TARGET_NAME)
if not target then
	warn("[ERROR] Target not in server: " .. TARGET_NAME)
	return
end

local network = ReplicatedStorage:FindFirstChild("Network")
local svc = network and network:FindFirstChild("TradeService")
local RE = svc and svc:FindFirstChild("RE")
if not RE then
	warn("[ERROR] TradeService.RE not found")
	return
end

local RequestTrade = RE:FindFirstChild("RequestTrade")
local ChangeOffer = RE:FindFirstChild("ChangeOffer")
local AdvanceTrade = RE:FindFirstChild("AdvanceTrade")
if not (RequestTrade and ChangeOffer and AdvanceTrade) then
	warn("[ERROR] Missing remotes")
	return
end

-- 1) open the trade once
print("[TRADE] Requesting trade...")
RequestTrade:FireServer(target)
task.wait(3) -- give the other side time to accept

-- 2) add every item, with a delay between each
for _, item in ipairs(ITEMS) do
	local name, qty = item[1], item[2]
	local ok, err = pcall(function()
		ChangeOffer:FireServer(name, qty)
	end)
	print(ok and ("[ADDED] " .. name .. " x" .. qty) or ("[FAIL] " .. name .. ": " .. tostring(err)))
	task.wait(ADD_DELAY)
end

-- 3) ready up once, after everything is in
task.wait(1)
AdvanceTrade:FireServer()
print("[DONE] Advanced trade")
