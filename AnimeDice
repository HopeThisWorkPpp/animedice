-- Anime Dice Auto-Trade Script
-- Sends Gems, Trait Rerolls, and Units to Only1sherif automatically
-- Based on Simple Spy capture

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local TARGET_NAME = "only1Sherifalt1"
local OFFER_QTY = 1000

print("[START] Anime Dice Auto-Trade Script")
print("[START] Target: " .. TARGET_NAME)
print("[START] Waiting 3 seconds before starting...")
wait(3)

-- Get target player
local targetPlayer = Players:FindFirstChild(TARGET_NAME)
if not targetPlayer then
	print("[ERROR] Target player '" .. TARGET_NAME .. "' not found!")
	return
end
print("[SUCCESS] Found target player: " .. targetPlayer.Name)

-- Get TradeService remotes
print("[INIT] Getting TradeService remotes...")
local TradeService = ReplicatedStorage:FindFirstChild("Network"):FindFirstChild("TradeService"):FindFirstChild("RE")

if not TradeService then
	print("[ERROR] Could not find ReplicatedStorage.Network.TradeService.RE!")
	return
end

local RequestTrade = TradeService:FindFirstChild("RequestTrade")
local ChangeOffer = TradeService:FindFirstChild("ChangeOffer")
local AdvanceTrade = TradeService:FindFirstChild("AdvanceTrade")

if not (RequestTrade and ChangeOffer and AdvanceTrade) then
	print("[ERROR] Could not find required remotes!")
	return
end

print("[SUCCESS] Found all remotes!")

-- Function to execute a trade
local function autoTrade(itemName)
	print("[TRADE] Starting trade for " .. itemName)
	
	-- Step 1: Request trade
	print("[TRADE] Requesting trade...")
	RequestTrade:FireServer(targetPlayer)
	wait(2)
	
	-- Step 2: Change offer
	print("[TRADE] Offering " .. itemName .. " x" .. OFFER_QTY)
	ChangeOffer:FireServer(itemName, OFFER_QTY)
	wait(1)
	
	-- Step 3: Advance trade (ready)
	print("[TRADE] Advancing trade...")
	AdvanceTrade:FireServer()
	wait(2)
	
	print("[SUCCESS] " .. itemName .. " trade sent!")
	return true
end

-- Main trading loop
local itemsToTrade = {
	"Trait Reroll",
	"Gems",
	"Lucky Spin",
}

for _, itemName in ipairs(itemsToTrade) do
	local tradeCount = 0
	while true do
		local success = autoTrade(itemName)
		
		if success then
			tradeCount = tradeCount + 1
			print("[LOOP] " .. itemName .. " trade #" .. tradeCount .. " completed")
			wait(3)
		else
			print("[NEXT] Moving to next item after " .. tradeCount .. " " .. itemName .. " trades")
			break
		end
	end
end

print("[COMPLETE] Trading script finished!")
