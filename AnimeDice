--=====================================================================
-- Runtime state
--=====================================================================
local lastTradeEndTime    = 0
local statusText          = "Idle"
local completedTrades     = 0
local plannedOffer        = nil
local lastRequestSent     = 0
local lastAdvance         = 0
local lastOfferPush       = 0
local lastRequestsEnable  = 0
local awaitingPartnerReady   = false
local awaitingPartnerConfirm = false

local tradeState = {
    [1]=false, [2]=nil, [3]="Offer", [4]={}, [5]=0,
    [6]=false, [7]=false, [8]=false, [9]=false, [10]=0
}

--=====================================================================
-- Target resolution
--=====================================================================
local function getTargetPlayer()
    for _, p in Players:GetPlayers() do
        if p ~= LocalPlayer
            and (string.lower(p.Name) == string.lower(TARGET_NAME)
                 or string.lower(p.DisplayName) == string.lower(TARGET_NAME))
        then
            return p
        end
    end
    return nil
end

--=====================================================================
-- Plan builder
--=====================================================================
local function getKeepAmount()
    return math.max(0, math.floor(tonumber(S.KeepAmount) or 0))
end

local function getSendAmount()
    return tonumber(S.SendAmount) or math.huge
end

local function getMaxEntries()
    return math.clamp(math.floor(tonumber(S.AutoTradeMaxEntries) or 20), 1, TradeConfig.MAX_UNIQUE_ENTRIES)
end

local function buildOfferPlan()
    local plan = {}
    if not (S.GiveUnits or S.GiveItems) then return plan end

    local placedSet  = S.SkipPlaced and getPlacedSet() or {}
    local keepAmount = getKeepAmount()
    local sendAmount = getSendAmount()
    local maxEntries = getMaxEntries()

    for key, entry in getOwnedEntries() do
        if #plan >= maxEntries then break end
        if type(key) == "string" and type(entry) == "table" then
            local cfg = EntryRegistry.getEntryConfig(entry.name)
            if cfg and not table.find(TradeConfig.UNTRADEABLE_ENTRIES, entry.name) then
                if cfg.kind == "Unit" then
                    if S.GiveUnits
                        and not (S.SkipLocked and isLocked(entry))
                        and not (S.SkipPlaced and placedSet[key])
                        and inSet(S.Characters, entry.name)
                        and inSet(S.Rarities, getRarity(entry))
                    then
                        plan[#plan + 1] = {
                            key = key,
                            amount = math.max(1, tonumber(entry.amount) or 1)
                        }
                    end
                elseif S.GiveItems then
                    if next(S.Items) == nil or S.Items[entry.name] then
                        local have = tonumber(entry.amount) or 0
                        local give = math.min(have - keepAmount, sendAmount)
                        if give >= 1 then
                            plan[#plan + 1] = { key = key, amount = math.floor(give) }
                        end
                    end
                end
            end
        end
    end
    return plan
end

local function getPlannedAmount(key)
    if not plannedOffer then return 0 end
    for _, e in plannedOffer do
        if e.key == key then return e.amount end
    end
    return 0
end

local function offerMatchesPlan()
    if not plannedOffer then return false end
    for _, e in plannedOffer do
        local have = tonumber(tradeState[4][e.key]) or 0
        if have < e.amount then return false end
    end
    return true
end

local function hasUnexpectedOffer()
    for key, amount in tradeState[4] do
        if (tonumber(amount) or 0) > getPlannedAmount(key) then
            return true
        end
    end
    return false
end

local function resetTradeState()
    tradeState[1]  = false
    tradeState[2]  = nil
    tradeState[3]  = "Offer"
    tradeState[4]  = {}
    tradeState[5]  = 0
    tradeState[6]  = false
    tradeState[7]  = false
    tradeState[8]  = false
    tradeState[9]  = false
    plannedOffer   = nil
    awaitingPartnerReady   = false
    awaitingPartnerConfirm = false
end

--=====================================================================
-- Notify helpers
--=====================================================================
local function notify(title, content)
    pcall(function()
        Rayfield:Notify({
            Title = title,
            Content = content,
            Duration = 5,
        })
    end)
end

--=====================================================================
-- TradeEvent listener
--=====================================================================
S_tradeEvent:Connect(function(eventName, data)
    if type(eventName) ~= "string" then return end
    data = type(data) == "table" and data or {}

    if eventName == "Started" then
        resetTradeState()
        tradeState[1]  = true
        tradeState[2]  = data.partner
        tradeState[10] = os.clock()
    elseif eventName == "Updated" then
        tradeState[1] = true
        tradeState[2] = data.partner or tradeState[2]
        tradeState[3] = type(data.phase) == "string" and data.phase or "Offer"
        tradeState[4] = type(data.ownOffer) == "table" and data.ownOffer or {}
        local otherCount = 0
        if type(data.otherOffer) == "table" then
            for _ in data.otherOffer do otherCount += 1 end
        end
        tradeState[5] = otherCount
        tradeState[6] = data.ownReady      == true
        tradeState[7] = data.otherReady    == true
        tradeState[8] = data.ownAccepted   == true
        tradeState[9] = data.otherAccepted == true
    elseif eventName == "Ended" then
        local reason = tostring(data.reason or "Unknown")
        if reason == "Completed" then
            completedTrades += 1
        end
        resetTradeState()
        lastTradeEndTime = os.clock()
        if S.AutoTrade then
            notify("Trade ended", reason)
        end
    end
end)

--=====================================================================
-- Account / requests-enabled checks
--=====================================================================
local function areTradeRequestsEnabled()
    return unwrap(DataController.TradeRequestsEnabled) == true
end

local function checkEligibility()
    if LocalPlayer.AccountAge < TradeConfig.MIN_ACCOUNT_AGE then
        return ("Account must be %d days old"):format(TradeConfig.MIN_ACCOUNT_AGE)
    end
    local rolls = tonumber(unwrap(DataController.Rolls)) or 0
    if rolls < TradeConfig.MIN_ROLLS then
        return ("Need %d rolls (%d)"):format(TradeConfig.MIN_ROLLS, rolls)
    end
    return nil
end

--=====================================================================
-- Offer pushing + ready/confirm
--=====================================================================
local function pushNextChunk()
    if os.clock() - lastOfferPush < 0.12 then return end
    for _, e in plannedOffer do
        local have = tonumber(tradeState[4][e.key]) or 0
        local missing = e.amount - have
        if missing > 0 then
            local chunk = 1
            for _, step in { 1000, 100, 10 } do
                if missing >= step then chunk = step; break end
            end
            lastOfferPush = os.clock()
            fire(S_changeOffer, e.key, chunk)
            return
        end
    end
end

local function readyOrConfirm()
    if os.clock() - lastAdvance < 0.35 then return end
    lastAdvance = os.clock()
    fire(S_advanceTrade)
end

--=====================================================================
-- Active trade tick
--=====================================================================
local function tickActiveTrade()
    if hasUnexpectedOffer() then
        statusText = "Cancelling, unexpected offer"
        fire(S_cancelTrade)
        return
    end

    if tradeState[3] == "Countdown" then
        statusText = "Countdown"
        return
    end

    -- Push offer until it matches the plan
    if not plannedOffer then plannedOffer = buildOfferPlan() end
    if #plannedOffer == 0 then
        statusText = "Nothing matches the give filters"
        fire(S_cancelTrade)
        return
    end
    if not offerMatchesPlan() then
        statusText = ("Offering (%d entries)"):format(#plannedOffer)
        pushNextChunk()
        return
    end

    -- Phase: Offer → ready up
    if tradeState[3] == "Offer" then
        if not tradeState[6] then
            statusText = "Readying up"
            readyOrConfirm()
        else
            if not awaitingPartnerReady then
                awaitingPartnerReady = true
                notify("Trade", "Main is ready. Click READY on the alt.")
            end
            statusText = "Waiting for partner to ready"
        end
        return
    end

    -- Phase: Confirm → confirm
    if tradeState[3] == "Confirm" then
        if not S.AutoConfirm then
            statusText = "Waiting for manual confirm"
            return
        end
        if not tradeState[8] then
            statusText = "Confirming"
            readyOrConfirm()
        else
            if not awaitingPartnerConfirm then
                awaitingPartnerConfirm = true
                notify("Trade", "Main confirmed. Click CONFIRM on the alt.")
            end
            statusText = "Waiting for partner confirm"
        end
    end
end

--=====================================================================
-- Find-a-trade tick
--=====================================================================
local function tickFindTrade()
    if os.clock() - lastTradeEndTime < S.AutoTradeDelay then
        statusText = ("Cooling down (%.0fs)"):format(S.AutoTradeDelay - (os.clock() - lastTradeEndTime))
        return
    end

    plannedOffer = buildOfferPlan()
    if #plannedOffer == 0 then
        statusText = "Nothing matches the give filters"
        return
    end

    if not S.AutoTradeLoop and completedTrades > 0 then
        statusText = "Finished — turn Auto Trade off or it will keep requesting"
        return
    end

    if os.clock() - lastRequestSent < 1 then return end

    local target = getTargetPlayer()
    if not target then
        statusText = "Waiting for " .. TARGET_NAME .. " to join server"
        return
    end

    lastRequestSent = os.clock()
    statusText = "Requesting " .. target.Name
    notify("Trade", "Request sent. Click ACCEPT on the alt.")
    fire(S_requestTrade, target)
end

--=====================================================================
-- Main tick
--=====================================================================
local function tickAutoTrade()
    local eligibility = checkEligibility()
    if eligibility then statusText = eligibility; return end

    if S.AutoTradeEnableRequests
        and not areTradeRequestsEnabled()
        and os.clock() - lastRequestsEnable >= 2
    then
        lastRequestsEnable = os.clock()
        fire(S_setRequestsOn, true)
    end

    if tradeState[1] then
        tickActiveTrade()
    else
        tickFindTrade()
    end
end

--=====================================================================
-- Driver loop
--=====================================================================
task.spawn(function()
    while true do
        task.wait(0.2)
        if S.AutoTrade then
            pcall(tickAutoTrade)
        elseif statusText ~= "Idle" then
            statusText = "Idle"
        end
        pcall(function()
            statusLabel:Set(statusText)
            countLabel:Set("Trades: " .. tostring(completedTrades))
        end)
    end
end)

notify("Trade Sender ready", "Target: " .. TARGET_NAME)
