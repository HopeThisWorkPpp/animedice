-- Anime Dice Auto-Trade (auto-inventory version)
-- Reads your actual inventory, sends target-rarity units + consumables in one trade

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TARGET_NAME = "only1Sherifalt1"
local ADD_DELAY = 0.6

-- Rarity tiers to send (in order of preference) — must match entryConfig.rarity strings exactly
local RARITY_TIERS = { "Mythic", "Secret II", "Secret I", "Celestial" }
local RARITY_ACCEPT = {}
for _, r in ipairs(RARITY_TIERS) do RARITY_ACCEPT[r] = true end

print("[START] Waiting 3s...")
task.wait(3)

local target = Players:FindFirstChild(TARGET_NAME)
if not target then
	warn("[ERROR] Target not in server: " .. TARGET_NAME)
	return
end

local RS = ReplicatedStorage
local ok, DataController = pcall(require, RS.Framework.Features.Data.DataController)
if not ok then
	warn("[ERROR] Could not load DataController")
	return
end

-- Find the real inventory table (name/attributes/amount shape)
local inventory = nil
if getgc then
	for _, t in ipairs(getgc(true)) do
		if type(t) == "table" and rawget(t, "Inventory") then
			local candidate = rawget(t, "Inventory")
			if type(candidate) == "table" and rawget(candidate, "Luck III") then
				inventory = candidate
				print("[FOUND] Inventory located")
				break
			end
		end
	end
end

if not inventory then
	warn("[ERROR] Could not find inventory in memory")
	return
end

-- Find the unit rarity config, preferring a stable module over live UI memory.
-- Primary: scan ReplicatedStorage ModuleScripts for a table keyed by unit name,
-- or a {entries = {name -> cfg}} table, where cfg.entryConfig.rarity exists.
local function hasRarity(cfg)
	if type(cfg) ~= "table" then return false end
	local ec = rawget(cfg, "entryConfig")
	return type(ec) == "table" and rawget(ec, "rarity") ~= nil
end

local function scanModule(result)
	-- result itself is a name -> cfg table
	for _, v in pairs(result) do
		if hasRarity(v) then
			return result
		end
	end
	-- or it holds a nested {entries = {name -> cfg}} table
	for _, v in pairs(result) do
		if type(v) == "table" then
			local entries = rawget(v, "entries")
			if type(entries) == "table" then
				for _, cfg in pairs(entries) do
					if hasRarity(cfg) then
						return entries
					end
				end
			end
		end
	end
	return nil
end

local function findUnitConfigs()
	for _, inst in ipairs(RS:GetDescendants()) do
		if inst:IsA("ModuleScript") then
			local success, result = pcall(require, inst)
			if success and type(result) == "table" then
				local okScan, found = pcall(scanModule, result)
				if okScan and found then
					return found, inst
				end
			end
		end
	end
	return nil
end

local UnitConfigs, foundIn = findUnitConfigs()
if UnitConfigs then
	print("[FOUND] Unit config module: " .. foundIn:GetFullName())
end

-- Fallback: old getgc scan (depends on a UI widget being alive in memory)
if not UnitConfigs and getgc then
	print("[SCAN] Module scan failed, falling back to getgc scan (open your units/inventory menu for this to work)...")
	for _, t in ipairs(getgc(true)) do
		if type(t) == "table" and rawget(t, "entries") and rawget(t, "stackable") ~= nil then
			local entries = rawget(t, "entries")
			if type(entries) == "table" then
				for _, cfg in pairs(entries) do
					if hasRarity(cfg) then
						UnitConfigs = entries
						break
					end
				end
			end
		end
		if UnitConfigs then break end
	end
end

if not UnitConfigs then
	warn("[ERROR] Could not find unit rarity config table — aborting rather than sending unknown-rarity units")
	return
end

-- Build name -> rarity lookup
local RARITY_LOOKUP = {}
for name, cfg in pairs(UnitConfigs) do
	if hasRarity(cfg) then
		RARITY_LOOKUP[name] = rawget(rawget(cfg, "entryConfig"), "rarity")
	end
end
do
	local n = 0
	for _ in pairs(RARITY_LOOKUP) do n = n + 1 end
	print("[FOUND] Rarity lookup built with " .. n .. " entries")
end

-- Get remotes
local network = RS:FindFirstChild("Network")
local svc = network and network:FindFirstChild("TradeService")
local RE = svc and svc:FindFirstChild("RE")
if not RE then
	warn("[ERROR] TradeService.RE not found")
	return
end

local RequestTrade = RE:FindFirstChild("RequestTrade")
local ChangeOffer = RE:FindFirstChild("ChangeOffer")
local AdvanceTrade = RE:FindFirstChild("AdvanceTrade")
if not (RequestTrade and ChangeOffer and AdvanceTrade) then
	warn("[ERROR] Missing remotes")
	return
end

local toTrade = {}

-- 1) Add units matching target rarity tiers
print("[SCAN] Looking for " .. table.concat(RARITY_TIERS, "/") .. " units...")
local unitCount = 0
for uuid, item in pairs(inventory) do
	if type(item) == "table" and item.name and type(uuid) == "string" and uuid:match("^[0-9a-f%-]+$") then
		local rarity = RARITY_LOOKUP[item.name]
		if rarity and RARITY_ACCEPT[rarity] then
			table.insert(toTrade, {uuid, 1})
			unitCount = unitCount + 1
			print("  [UNIT] " .. item.name .. " (" .. rarity .. ")")
		end
	end
end
print("[SCAN] Found " .. unitCount .. " matching units")

-- 2) Add consumables
local consumables = {"Trait Reroll", "Gems", "Lucky Spin", "Luck IV", "Luck III", "Luck II", "Luck I"}
print("[SCAN] Looking for consumables...")
for _, cname in ipairs(consumables) do
	local item = inventory[cname]
	if item and item.amount and item.amount > 0 then
		table.insert(toTrade, {cname, item.amount})
		print("  [FOUND] " .. cname .. " x" .. item.amount)
	end
end

if #toTrade == 0 then
	warn("[ERROR] No items to trade!")
	return
end

print("[TRADE] Requesting trade with " .. #toTrade .. " items...")
RequestTrade:FireServer(target)
task.wait(3)

for _, item in ipairs(toTrade) do
	local key, qty = item[1], item[2]
	local ok2, err = pcall(function()
		ChangeOffer:FireServer(key, qty)
	end)
	local label = inventory[key] and inventory[key].name or key
	print(ok2 and ("[ADDED] " .. label .. " x" .. qty) or ("[FAIL] " .. label))
	task.wait(ADD_DELAY)
end

task.wait(1)
AdvanceTrade:FireServer()
print("[DONE] Trade advanced")
