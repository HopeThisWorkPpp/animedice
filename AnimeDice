local function fire(sig, ...)
    if not sig then return false end
    local a = table.pack(...)
    return pcall(function() sig:Fire(table.unpack(a, 1, a.n)) end)
end

local function invoke(fn, ...)
    if not fn then return false, nil end
    local a = table.pack(...)
    return pcall(function() return fn:Invoke(table.unpack(a, 1, a.n)) end)
end

