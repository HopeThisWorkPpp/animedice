local function buildUnitFields(inventory)
    local byRarity = {}
    for _, r in ipairs(RARITY_ORDER) do byRarity[r] = {} end
    byRarity["Unknown"] = {}

    local totalUnits = 0
    for key, entry in pairs(inventory) do
        if type(key) == "string" and type(entry) == "table" and entry.name then
            local cfg = EntryRegistry.getEntryConfig(entry.name)
            if cfg and cfg.kind == "Unit" then
                local rarity = getRarity(entry) or "Unknown"
                if not byRarity[rarity] then byRarity[rarity] = {} end
                local amt = math.max(1, math.floor(tonumber(entry.amount) or 1))
                byRarity[rarity][#byRarity[rarity] + 1] = { name = entry.name, amount = amt }
                totalUnits += amt
            end
        end
    end

    for _, list in pairs(byRarity) do
        table.sort(list, function(a, b)
            if a.amount ~= b.amount then return a.amount > b.amount end
            return a.name < b.name
        end)
    end

    local fields = {}
    local order = {}
    for _, r in ipairs(RARITY_ORDER) do order[#order + 1] = r end
    order[#order + 1] = "Unknown"

    for _, rarity in ipairs(order) do
        local list = byRarity[rarity]
        if list and #list > 0 then
            local lines = {}
            local bufLen = 0
            for _, u in ipairs(list) do
                local line = ("%s **%s** x%s"):format(RARITY_EMOJI[rarity] or "❔", u.name, formatNumber(u.amount))
                if bufLen + #line + 1 > 1000 then lines[#lines + 1] = "…"; break end
                lines[#lines + 1] = line
                bufLen = bufLen + #line + 1
            end
            fields[#fields + 1] = {
                name = ("%s %s — %d unique"):format(RARITY_EMOJI[rarity] or "❔", rarity, #list),
                value = table.concat(lines, "\n"),
                inline = false,
            }
        end
    end
    return fields, totalUnits
end

local function buildItemFields(inventory)
    local CATEGORIES = {
        { name = "🎰 Jackpot Spins",  patterns = { "Jackpot Spin" }, emoji = "🎰" },
        { name = "🍀 Lucky Spins",    patterns = { "Lucky Spin" },   emoji = "🍀" },
        { name = "🎡 Spins",          patterns = { "^Spin", " Spin$" }, emoji = "🎡" },
        { name = "💎 Gems",           patterns = { "Gems" },          emoji = "💎" },
        { name = "🍀 Luck Potions",   patterns = { "Luck" },          emoji = "🍀" },
        { name = "💰 Income Potions", patterns = { "Income" },        emoji = "💰" },
        { name = "🎲 Trait Rerolls",  patterns = { "Trait Reroll" },  emoji = "🎲" },
        { name = "📈 Grade Rerolls",  patterns = { "Grade" },         emoji = "📈" },
    }

    local items = {}
    for key, entry in pairs(inventory) do
        if type(key) == "string" and type(entry) == "table" and entry.name then
            local cfg = EntryRegistry.getEntryConfig(entry.name)
            if cfg and cfg.kind ~= "Unit" then
                local amt = tonumber(entry.amount) or 0
                if amt > 0 then
                    items[#items + 1] = { name = entry.name, amount = math.floor(amt) }
                end
            end
        end
    end

    if #items == 0 then return {}, 0 end
    table.sort(items, function(a, b) return a.name < b.name end)

    local grouped = {}
    local totalItems = 0
    local ungrouped = {}

    for _, it in ipairs(items) do
        totalItems += it.amount
        local placed = false
        for _, cat in ipairs(CATEGORIES) do
            for _, pat in ipairs(cat.patterns) do
                if string.find(it.name, pat) then
                    grouped[cat.name] = grouped[cat.name] or { emoji = cat.emoji, list = {} }
                    table.insert(grouped[cat.name].list, it)
                    placed = true
                    break
                end
            end
            if placed then break end
        end
        if not placed then ungrouped[#ungrouped + 1] = it end
    end

    local fields = {}
    for _, cat in ipairs(CATEGORIES) do
        local g = grouped[cat.name]
        if g and #g.list > 0 then
            local lines = {}
            local bufLen = 0
            for _, it in ipairs(g.list) do
                local line = ("%s **%s** x%s"):format(g.emoji, it.name, formatNumber(it.amount))
                if bufLen + #line + 1 > 1000 then lines[#lines + 1] = "…"; break end
                lines[#lines + 1] = line
                bufLen = bufLen + #line + 1
            end
            fields[#fields + 1] = {
                name = ("%s (%d types)"):format(cat.name, #g.list),
                value = table.concat(lines, "\n"),
                inline = false,
            }
        end
    end

    if #ungrouped > 0 then
        local lines = {}
        local bufLen = 0
        for _, it in ipairs(ungrouped) do
            local line = ("📦 **%s** x%s"):format(it.name, formatNumber(it.amount))
            if bufLen + #line + 1 > 1000 then lines[#lines + 1] = "…"; break end
            lines[#lines + 1] = line
            bufLen = bufLen + #line + 1
        end
        fields[#fields + 1] = {
            name = ("📦 Other Items (%d types)"):format(#ungrouped),
            value = table.concat(lines, "\n"),
            inline = false,
        }
    end
    return fields, totalItems
end

--=====================================================================
-- Send webhook
--=====================================================================
local function sendInventoryWebhook(label)
    if WEBHOOK_URL == "" or string.find(WEBHOOK_URL, "PASTE_YOUR") then
        warn("[WEBHOOK] No URL configured")
        return false
    end

    local inventory = deepUnwrap(DataController.Inventory)
    if type(inventory) ~= "table" then
        warn("[WEBHOOK] Could not read inventory")
        return false
    end

    local unitFields, totalUnits = buildUnitFields(inventory)
    local itemFields, totalItems = buildItemFields(inventory)

    local srv         = getServerLink()
    local playerCount = #Players:GetPlayers()
    local maxPlayers  = Players.MaxPlayers

    -- Discord allows 25 fields max. Server info goes first.
    local allFields = {}

    allFields[#allFields + 1] = {
        name = "🔗 Server Info",
        value = ("`JobId: %s`\n`Players: %d/%d`\n`Place: %s`"):format(
            srv.jobId, playerCount, maxPlayers, srv.placeId
        ),
        inline = false,
    }

    for _, f in ipairs(unitFields) do
        if #allFields >= 25 then break end
        allFields[#allFields + 1] = f
    end
    for _, f in ipairs(itemFields) do
        if #allFields >= 25 then break end
        allFields[#allFields + 1] = f
    end

    -- Color from highest-tier rarity present
    local embedColor = 0x2ECC71
    for _, rarity in ipairs(RARITY_ORDER) do
        for _, f in ipairs(unitFields) do
            if string.find(f.name, rarity, 1, true) then
                embedColor = RARITY_COLOR[rarity] or embedColor
                goto done
            end
        end
    end
    ::done::

    local titlePrefix = label
        and ("📦 Inventory Snapshot — " .. label)
        or  "📦 Inventory Snapshot"

    local payload = {
        username = "Anime Dice Tracker",
        embeds = {
            {
                title       = titlePrefix,
                url         = srv.webLink,
                description = ("**%s**\n%d units  •  %d items  •  %d unique unit types"):format(
                    LocalPlayer.Name, totalUnits, totalItems, #unitFields
                ),
                color     = embedColor,
                fields    = allFields,
                footer    = { text = "Anime Dice • " .. os.date("%Y-%m-%d %H:%M:%S") },
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }
        },
        components = {
            {
                type = 1,
                components = {
                    {
                        type  = 2,
                        style = 5,
                        label = "🎮 Join Server",
                        url   = srv.webLink,
                    },
                }
            }
        }
    }

    local json = HttpService:JSONEncode(payload)
    local ok, res = httpPost(WEBHOOK_URL, json)
    if not ok then
        warn("[WEBHOOK] Failed to send: " .. tostring(res))
        return false
    end
    print("[WEBHOOK] Sent (" .. tostring(label or "snapshot") .. ")")
    return true
end

--=====================================================================
-- Trade event tracker
--=====================================================================
local trade = {
    active = false, phase = "Offer", ownOffer = {},
    ownReady = false, otherReady = false,
    ownAccepted = false, otherAccepted = false,
    otherOfferCount = 0,
}

TradeEvent:Connect(function(eventName, data)
    if type(eventName) ~= "string" then return end
    data = type(data) == "table" and data or {}

    if eventName == "Started" then
        trade.active = true
        trade.phase = "Offer"
        trade.ownOffer = {}
        trade.ownReady, trade.otherReady = false, false
        trade.ownAccepted, trade.otherAccepted = false, false
        trade.otherOfferCount = 0
    elseif eventName == "Updated" then
        trade.active = true
        trade.phase = type(data.phase) == "string" and data.phase or "Offer"
        trade.ownOffer = type(data.ownOffer) == "table" and data.ownOffer or {}
        local otherCount = 0
        if type(data.otherOffer) == "table" then
            for _ in data.otherOffer do otherCount += 1 end
        end
        trade.otherOfferCount = otherCount
        trade.ownReady      = data.ownReady == true
        trade.otherReady    = data.otherReady == true
        trade.ownAccepted   = data.ownAccepted == true
        trade.otherAccepted = data.otherAccepted == true
    elseif eventName == "Ended" then
        trade.active = false
        trade.phase = "Offer"
        trade.ownOffer = {}
        trade.ownReady, trade.otherReady = false, false
        trade.ownAccepted, trade.otherAccepted = false, false
    end
end)

--=====================================================================
-- Plot pickup
--=====================================================================
local function pickupPlacedUnits()
    local slots = deepUnwrap(DataController.Slots)
    if type(slots) ~= "table" then
        warn("[PICKUP] Could not read DataController.Slots")
        return 0
    end

    local slotList = {}
    for slotNum, data in pairs(slots) do
        if type(data) == "table" and data.unitId then
            slotList[#slotList + 1] = { slot = tonumber(slotNum) or slotNum, data = data }
        end
    end
    table.sort(slotList, function(a, b) return tonumber(a.slot) < tonumber(b.slot) end)

    local removed = 0
    for _, item in ipairs(slotList) do
        local rarity = getRarity(item.data)
        if rarity and RARITY_FILTER[rarity] then
            print(("[PICKUP] Slot %s → %s (%s)"):format(tostring(item.slot), tostring(item.data.name), rarity))
            fire(InteractSlot, item.slot)
            removed += 1
            task.wait(PICKUP_DELAY)
        end
    end
    if removed > 0 then task.wait(1.5) end
    return removed
end

--=====================================================================
-- Build offer plan
--=====================================================================
local function buildOffer()
    local inventory = deepUnwrap(DataController.Inventory)
    if type(inventory) ~= "table" then return {} end

    local wantConsumable = {}
    for _, n in ipairs(CONSUMABLES) do wantConsumable[n] = true end

    local plan = {}
    for key, entry in pairs(inventory) do
        if type(key) == "string" and type(entry) == "table" and entry.name then
            local cfg = EntryRegistry.getEntryConfig(entry.name)
            if cfg and cfg.kind == "Unit" then
                local rarity = getRarity(entry)
                if rarity and RARITY_FILTER[rarity] then
                    local locked = entry.attributes and entry.attributes.locked == true
                    if not locked then
                        plan[#plan + 1] = {
                            key    = key,
                            amount = math.max(1, tonumber(entry.amount) or 1),
                            label  = entry.name .. " (" .. rarity .. ")",
                        }
                    end
                end
            elseif wantConsumable[entry.name] then
                local amt = tonumber(entry.amount) or 0
                if amt > 0 then
                    plan[#plan + 1] = {
                        key    = key,
                        amount = math.floor(amt),
                        label  = entry.name .. " x" .. math.floor(amt),
                    }
                end
            end
        end
    end
    return plan
end

--=====================================================================
-- Offer helpers
--=====================================================================
local function offerMatchesPlan(plan)
    for _, e in ipairs(plan) do
        local have = tonumber(trade.ownOffer[e.key]) or 0
        if have < e.amount then return false end
    end
    return true
end

local function pushOneChunk(plan)
    for _, e in ipairs(plan) do
        local have    = tonumber(trade.ownOffer[e.key]) or 0
        local missing = e.amount - have
        if missing > 0 then
            local chunk = 1
            for _, step in ipairs({ 1000, 100, 10 }) do
                if missing >= step then chunk = step; break end
            end
            fire(ChangeOffer, e.key, chunk)
            return true
        end
    end
    return false
end

local function waitForOfferSync(plan, timeout)
    timeout = timeout or 15
    local deadline = os.clock() + timeout
    local lastPush = 0
    while os.clock() < deadline do
        if offerMatchesPlan(plan) then return true end
        if os.clock() - lastPush >= OFFER_PUSH_DELAY then
            if pushOneChunk(plan) then
                lastPush = os.clock()
            else
                return false
            end
        end
        task.wait(0.05)
    end
    return false
end

local function holdReady()
    for attempt = 1, READY_MAX_RETRIES do
        if trade.ownReady then
            print(("[READY] Hold confirmed on attempt %d"):format(attempt))
            return true
        end
        fire(AdvanceTrade)
        local deadline = os.clock() + READY_RETRY_DELAY
        while os.clock() < deadline do
            if trade.ownReady or trade.phase == "Confirm" then
                return true
            end
            task.wait(0.1)
        end
    end
    warn("[READY] Could not hold ready state")
    return false
end

--=====================================================================
-- Find target player
--=====================================================================
local function findTarget()
    for _, p in Players:GetPlayers() do
        if p ~= LocalPlayer
            and (string.lower(p.Name) == string.lower(TARGET_NAME)
                 or string.lower(p.DisplayName) == string.lower(TARGET_NAME))
        then
            return p
        end
    end
    return nil
end

