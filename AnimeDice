local function tradeUnwrap(v)
  if type(v) == "function" then local ok, r = pcall(v); return ok and r or nil end
  local mt = type(v) == "table" and getmetatable(v)
  if mt and mt.__call then local ok, r = pcall(function() return v() end); return ok and r or v end
  return v
end

local function tradeDeepUnwrap(source)
  local out = {}
  local flat = tradeUnwrap(source)
  if type(flat) == "table" then for k, v in pairs(flat) do out[k] = v end end
  if type(source) == "table" then
    local c = rawget(source, "___C")
    if type(c) == "table" then
      for k, v in pairs(c) do
        if out[k] == nil then
          local inner = tradeUnwrap(v)
          if inner ~= nil then out[k] = inner end
        end
      end
    end
  end
  return out
end

