local function httpPost(url, body)
    local payload = { Url=url, Method="POST",
                      Headers={["Content-Type"]="application/json"}, Body=body }
    if typeof(request) == "function" then
        local ok, res = pcall(request, payload); if ok and res then return true, res end
    end
    if typeof(http_request) == "function" then
        local ok, res = pcall(http_request, payload); if ok and res then return true, res end
    end
    if typeof(http) == "table" and typeof(http.request) == "function" then
        local ok, res = pcall(http.request, payload); if ok and res then return true, res end
    end
    return false, "No HTTP library"
end

local function buildUnitFields(inv)
    local allowed = {}
    for r, on in pairs(RARITY_FILTER) do if on then allowed[r] = true end end
    local byRarity = {}
    for r in pairs(allowed) do byRarity[r] = {} end
    local totalUnits, uniqueCount = 0, 0
    for k, e in pairs(inv) do
        if type(k) == "string" and type(e) == "table" and e.name then
            local cfg = EntryRegistry.getEntryConfig(e.name)
            if cfg and cfg.kind == "Unit" then
                local r = getRarity(e)
                if r and allowed[r] then
                    local amt = math.max(1, math.floor(tonumber(e.amount) or 1))
                    byRarity[r][#byRarity[r]+1] = { name = e.name, amount = amt }
                    totalUnits = totalUnits + amt
                    uniqueCount = uniqueCount + 1
                end
            end
        end
    end
    for _, list in pairs(byRarity) do
        table.sort(list, function(a,b)
            if a.amount ~= b.amount then return a.amount > b.amount end
            return a.name < b.name
        end)
    end
    local fields = {}
    for _, r in ipairs(RARITY_ORDER) do
        local list = byRarity[r]
        if list and #list > 0 then
            local lines, bufLen, tierTotal = {}, 0, 0
            for _, u in ipairs(list) do
                tierTotal = tierTotal + u.amount
                local line = ("`%s` **%s** x%s"):format(RARITY_TAG[r] or "[?]", u.name, fmtNum(u.amount))
                if bufLen + #line + 1 > 1000 then lines[#lines+1] = "..."; break end
                lines[#lines+1] = line
                bufLen = bufLen + #line + 1
            end
            fields[#fields+1] = { name = ("%s -- %d unique, %d total"):format(r, #list, tierTotal),
                                  value = table.concat(lines, "\n"), inline = false }
        end
    end
    return fields, totalUnits, uniqueCount
end

local function buildItemFields(inv)
    local want = {}
    for _, n in ipairs(CONSUMABLES) do want[n] = true end
    local items, totalItems = {}, 0
    for k, e in pairs(inv) do
        if type(k) == "string" and type(e) == "table" and e.name and want[e.name] then
            local amt = tonumber(e.amount) or 0
            if amt > 0 then
                items[#items+1] = { name = e.name, amount = math.floor(amt), tag = itemTag(e.name) }
                totalItems = totalItems + math.floor(amt)
            end
        end
    end
    if #items == 0 then return {}, 0 end
    table.sort(items, function(a,b)
        if a.amount ~= b.amount then return a.amount > b.amount end
        return a.name < b.name
    end)
    local fields, lines, bufLen = {}, {}, 0
    local header = ("Consumables -- %d types, %d total"):format(#items, totalItems)
    for _, it in ipairs(items) do
        local line = ("`%s` **%s** x%s"):format(it.tag, it.name, fmtNum(it.amount))
        if bufLen + #line + 1 > 1000 then
            fields[#fields+1] = { name = (#fields == 0) and header or "Consumables (cont.)",
                                  value = table.concat(lines, "\n"), inline = false }
            lines, bufLen = {}, 0
        end
        lines[#lines+1] = line
        bufLen = bufLen + #line + 1
    end
    if #lines > 0 then
        fields[#fields+1] = { name = (#fields == 0) and header or "Consumables (cont.)",
                              value = table.concat(lines, "\n"), inline = false }
    end
    return fields, totalItems
end

local function sendInventoryWebhook(label)
    if WEBHOOK_URL == "" then return false end
    local inv = getOwnedEntries()
    if type(inv) ~= "table" then return false end
    local unitFields, totalUnits, uniqueUnits = buildUnitFields(inv)
    local itemFields, totalItems = buildItemFields(inv)
    local placeId, jobId = tostring(game.PlaceId), tostring(game.JobId)
    local webLink = ("https://www.roblox.com/games/start?placeId=%s&gameInstanceId=%s"):format(placeId, jobId)
    local players, maxPlayers = #Players:GetPlayers(), Players.MaxPlayers
    local shortJob = #jobId > 20 and (jobId:sub(1,20) .. "...") or jobId

    local allFields = {}
    allFields[#allFields+1] = {
        name = "Server Information",
        value = ("**Join:** [Click to Join](%s)\n**Job ID:** `%s`\n**Players:** `%d / %d`\n**Place ID:** `%s`"):format(
            webLink, shortJob, players, maxPlayers, placeId),
        inline = false,
    }
    for _, f in ipairs(unitFields) do if #allFields < 25 then allFields[#allFields+1] = f end end
    for _, f in ipairs(itemFields) do if #allFields < 25 then allFields[#allFields+1] = f end

    local embedColor, chosen = 0x2ECC71, false
    for _, r in ipairs(RARITY_ORDER) do
        if chosen then break end
        for _, f in ipairs(unitFields) do
            if string.find(f.name, r, 1, true) then
                embedColor = RARITY_COLOR[r] or embedColor; chosen = true; break
            end
        end
    end

    local summary = {
        ("**Player:** `%s`"):format(LocalPlayer.Name),
        ("**Server:** `%d/%d` players"):format(players, maxPlayers),
    }
    if uniqueUnits > 0 then summary[#summary+1] = ("**Rare units:** `%d` unique / `%d` total"):format(uniqueUnits, totalUnits) end
    if totalItems  > 0 then summary[#summary+1] = ("**Consumables:** `%d`"):format(totalItems) end

    local payload = {
        username = "Anime Dice Tracker",
        embeds = {{
            title = "Inventory Report" .. (label and (" -- " .. label) or ""),
            url = webLink,
            description = table.concat(summary, "\n"),
            color = embedColor,
            fields = allFields,
            footer = { text = "Anime Dice Tracker - " .. os.date("%Y-%m-%d %H:%M:%S") },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }},
        components = {{ type = 1, components = {
            { type = 2, style = 5, label = "Join This Server", url = webLink },
        }}},
    }
    local json = HttpService:JSONEncode(payload)
    return (httpPost(WEBHOOK_URL, json))
end

