local tradeComm = ClientComm.new(NetworkFolder, false, "TradeService")

local S_requestTrade     = tradeComm:GetSignal("RequestTrade")
local S_changeOffer      = tradeComm:GetSignal("ChangeOffer")
local S_advanceTrade     = tradeComm:GetSignal("AdvanceTrade")
