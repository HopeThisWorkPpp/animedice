local function isOffScreen(pos)
    return pos.X.Scale < -0.1 or pos.X.Scale > 1.1
        or pos.Y.Scale < -0.1 or pos.Y.Scale > 1.1
end

local hudSnapshot = nil

local function trySnapshot()
    for _, c in ipairs(hudChildren) do
        if c.Parent and isOffScreen(c.Position) then return false end
    end
    hudSnapshot = {}
    for _, c in ipairs(hudChildren) do
        if c.Parent then
            hudSnapshot[c] = { position = c.Position, anchor = c.AnchorPoint }
        end
    end
    return true
end

