--=====================================================================
-- Anime Dice Auto-Trade — with plot pickup via InteractSlot
--=====================================================================
local Players     = game:GetService("Players")
local RS          = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local TARGET_NAME  = "only1Sherifalt1"
local ADD_DELAY    = 0.7
local PICKUP_DELAY = 0.35

local RARITY_FILTER = {
    ["Celestial"] = true,
    ["Secret I"]  = true,
    ["Secret II"] = true,
    ["Mythical"]  = true,
}

local CONSUMABLES = {
    "Luck III", "Luck II", "Luck I", "Luck IV",
    "Lucky Spin", "Jackpot Spin",
    "Gems", "Income IV", "Trait Reroll",
}

--=====================================================================
-- Framework
--=====================================================================
local Framework = RS:WaitForChild("Framework")
local Features  = Framework:WaitForChild("Features")
local Packages  = RS:FindFirstChild("Packages") or Framework:WaitForChild("Packages")
local NetworkFolder = RS:FindFirstChild("Network") or Framework:WaitForChild("Network")

local DataController = require(Features.Data.DataController)
local EntryRegistry  = require(Features.Inventory.EntryRegistry)

local ClientComm = require(Packages.Network).ClientComm

--=====================================================================
-- Signals
--=====================================================================
local tradeComm = ClientComm.new(NetworkFolder, false, "TradeService")
local RequestTrade = tradeComm:GetSignal("RequestTrade")
local ChangeOffer  = tradeComm:GetSignal("ChangeOffer")
local AdvanceTrade = tradeComm:GetSignal("AdvanceTrade")
local CancelTrade  = tradeComm:GetSignal("CancelTrade")

local plotComm     = ClientComm.new(NetworkFolder, false, "PlotService")
local InteractSlot = plotComm:GetSignal("InteractSlot")   -- ← from SimpleSpy

local function fire(signal, ...)
    if not signal then return false end
    local args = table.pack(...)
    local ok, err = pcall(function()
        signal:Fire(table.unpack(args, 1, args.n))
    end)
    if not ok then warn("[FIRE FAIL] " .. tostring(err)) end
    return ok
end

--=====================================================================
-- Unwrap helpers
--=====================================================================
local function unwrap(v)
    if type(v) == "function" then
        local ok, r = pcall(v); return ok and r or nil
    end
    local mt = type(v) == "table" and getmetatable(v)
    if mt and mt.__call then
        local ok, r = pcall(function() return v() end)
        return ok and r or v
    end
    return v
end

local function deepUnwrap(source)
    local out = {}
    local flat = unwrap(source)
    if type(flat) == "table" then
        for k, v in pairs(flat) do out[k] = v end
    end
    if type(source) == "table" then
        local cached = rawget(source, "___C")
        if type(cached) == "table" then
            for k, v in pairs(cached) do
                if out[k] == nil then
                    local inner = unwrap(v)
                    if inner ~= nil then out[k] = inner end
                end
            end
        end
    end
    return out
end

--=====================================================================
-- Rarity
--=====================================================================
local function getRarity(entry)
    if type(entry) ~= "table" or not entry.name then return nil end
    local cfg = EntryRegistry.getEntryConfig(entry.name)
    if not cfg then return nil end
    if type(cfg.getRarity) == "function" then
        local ok, r = pcall(cfg.getRarity, entry.attributes or {})
        if ok and type(r) == "string" then return r end
    end
    if type(cfg.rarity) == "string" then return cfg.rarity end
    return nil
end

--=====================================================================
-- PLOT PICKUP — uses InteractSlot(slotNumber)
--=====================================================================
local function pickupPlacedUnits()
    local slots = deepUnwrap(DataController.Slots)
    if type(slots) ~= "table" then
        warn("[PICKUP] Could not read DataController.Slots")
        return 0
    end

    -- Collect slots in numeric order
    local slotList = {}
    for slotNum, data in pairs(slots) do
        if type(data) == "table" and data.unitId then
            slotList[#slotList + 1] = { slot = tonumber(slotNum) or slotNum, data = data }
        end
    end
    table.sort(slotList, function(a, b)
        return tonumber(a.slot) < tonumber(b.slot)
    end)

    local removed = 0
    for _, item in ipairs(slotList) do
        local entry  = item.data
        local rarity = getRarity(entry)

        if rarity and RARITY_FILTER[rarity] then
            print(("[PICKUP] Slot %s → %s (%s)"):format(
                tostring(item.slot), tostring(entry.name), rarity
            ))
            fire(InteractSlot, item.slot)     -- ← SimpleSpy-confirmed signature
            removed += 1
            task.wait(PICKUP_DELAY)
        end
    end

    if removed > 0 then
        print("[PICKUP] Waiting 1.5s for inventory to sync...")
        task.wait(1.5)
    end
    return removed
end

--=====================================================================
-- Build offer list
--=====================================================================
local function buildOffer()
    local inventory = deepUnwrap(DataController.Inventory)
    if type(inventory) ~= "table" then
        warn("[BUILD] Could not read inventory")
        return {}
    end

    local wantConsumable = {}
    for _, n in ipairs(CONSUMABLES) do wantConsumable[n] = true end

    local toTrade = {}
    local unitCount = 0

    for key, entry in pairs(inventory) do
        if type(key) == "string" and type(entry) == "table" and entry.name then
            local cfg = EntryRegistry.getEntryConfig(entry.name)

            if cfg and cfg.kind == "Unit" then
                local rarity = getRarity(entry)
                if rarity and RARITY_FILTER[rarity] then
                    local locked = entry.attributes and entry.attributes.locked == true
                    if not locked then
                        toTrade[#toTrade + 1] = {
                            key = key,
                            qty = math.max(1, tonumber(entry.amount) or 1),
                            label = entry.name .. " (" .. rarity .. ")",
                        }
                        unitCount += 1
                    end
                end
            elseif wantConsumable[entry.name] then
                local amt = tonumber(entry.amount) or 0
                if amt > 0 then
                    toTrade[#toTrade + 1] = {
                        key = key,
                        qty = math.floor(amt),
                        label = entry.name .. " x" .. math.floor(amt),
                    }
                    print("  [ITEM] " .. entry.name .. " x" .. math.floor(amt))
                end
            end
        end
    end

    print(("[BUILD] %d units, %d total entries"):format(unitCount, #toTrade))
    return toTrade
end

--=====================================================================
-- Target
--=====================================================================
local function findTarget()
    for _, p in Players:GetPlayers() do
        if p ~= LocalPlayer
            and (string.lower(p.Name) == string.lower(TARGET_NAME)
                 or string.lower(p.DisplayName) == string.lower(TARGET_NAME))
        then
            return p
        end
    end
    return nil
end

--=====================================================================
-- Main
--=====================================================================
local target = findTarget()
if not target then
    warn("[ERROR] Target not found: " .. TARGET_NAME)
    return
end

print("[MAIN] Step 1: Picking up matching units from plot...")
local picked = pickupPlacedUnits()
print(("[MAIN] Picked up %d unit(s)"):format(picked))

print("[MAIN] Step 2: Building offer...")
local toTrade = buildOffer()
if #toTrade == 0 then
    warn("[ERROR] Nothing to trade")
    return
end

print("[MAIN] Step 3: Requesting trade with " .. target.Name)
fire(RequestTrade, target)
task.wait(3)

print("[MAIN] Step 4: Adding items to offer...")
for _, item in ipairs(toTrade) do
    fire(ChangeOffer, item.key, item.qty)
    print("[OK] " .. item.label)
    task.wait(ADD_DELAY)
end

print("[MAIN] Step 5: Ready / Confirm")
task.wait(1)
fire(AdvanceTrade)   -- Offer → Ready
task.wait(2)
fire(AdvanceTrade)   -- Ready → Confirm
print("[DONE]")
