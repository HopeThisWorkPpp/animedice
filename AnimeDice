--[[ Auto-Sender — run on MAIN ]]
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local RE = game.ReplicatedStorage.Network.TradeService.RE

local TARGET_NAME = "Only1Sherifalt1"   -- ⚠️ VERIFY WITH DIAGNOSTIC FIRST
local STEP_DELAY = 2
local TRADE_DELAY = 5

local TRADE_LIST = {
    { Name = "TraitReroll", Amount = 1 },
    { Name = "Gems",        Amount = 1000 },
    { Name = "LuckySpin",   Amount = 1 },
}

local function findTarget()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name == TARGET_NAME then return p end
    end
    return nil
end

local function isTradeOpen()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            if string.find(d.Text:lower(), "ready") or string.find(d.Text:lower(), "offer") then
                return true
            end
        end
    end
    return false
end

local function sendTrade(itemName, amount)
    local target = findTarget()
    if not target then
        warn("[SENDER] Alt not in server")
        return false
    end

    print("[SENDER] Requesting trade with", target.Name)
    RE.RequestTrade:FireServer(target)
    task.wait(STEP_DELAY)

    if not isTradeOpen() then
        warn("[SENDER] Trade window never opened — alt not accepting?")
        return false
    end

    print("[SENDER] Trade open. Adding", itemName, "x", amount)
    RE.ChangeOffer:FireServer(itemName, amount)
    task.wait(STEP_DELAY)

    print("[SENDER] Ready up")
    RE.AdvanceTrade:FireServer()
    task.wait(STEP_DELAY)

    RE.AdvanceTrade:FireServer()
    task.wait(STEP_DELAY)

    print("[SENDER] Attempt done")
    return true
end

print("[SENDER] Starting in 5s — make sure alt is running auto-accept")
task.wait(5)

for _, entry in ipairs(TRADE_LIST) do
    print("[LOOP]", entry.Name)
    local count, fails = 0, 0
    while fails < 2 do
        if sendTrade(entry.Name, entry.Amount) then
            count = count + 1
            fails = 0
        else
            fails = fails + 1
            -- Don't hammer if trade isn't opening
            if fails >= 2 then
                warn("[SENDER] Stopping " .. entry.Name .. " — trades not opening")
                break
            end
        end
        task.wait(TRADE_DELAY)
    end
    print("[DONE]", entry.Name, "->", count, "successful")
end
