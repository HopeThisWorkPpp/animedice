        local r = PlayerGui:FindFirstChild("Root")
        local tw = r and r:FindFirstChild("Tower")
        if tw and F.AutoTowerHideUI then
            local screen = tw:FindFirstChild("Screen")
            if screen and screen:IsA("GuiObject") then
                screen.Position = UDim2.fromScale(4, 4)
            end
        end
    end
end)

