local S_setRequestsOn    = tradeComm:GetSignal("SetTradeRequestsEnabled")
local S_tradeEvent       = tradeComm:GetSignal("TradeEvent")

local function fire(sig, ...)
    if not sig then return false end
    local args = table.pack(...)
    return pcall(function()
        sig:Fire(table.unpack(args, 1, args.n))
    end)
end

--=====================================================================
-- Entry helpers
--=====================================================================
local function getOwnedEntries()
    local ok, result = pcall(function()
        return DataController.Inventory()
    end)
    return ok and result or {}
end

local function getPlacedSet()
    local set = {}
    local ok, slots = pcall(function()
        return DataController.Slots()
    end)
    if ok and type(slots) == "table" then
        for _, v in slots do
            if type(v) == "table" and type(v.unitId) == "string" then
                set[v.unitId] = true
            end
        end
    end
    return set
end

local function getAttr(entry, name)
    if type(entry) ~= "table" or type(entry.attributes) ~= "table" then
        return nil
    end
    return entry.attributes[name]
end

local function isLocked(entry)
    return getAttr(entry, "locked") == true
end

local function getRarity(entry)
    local cfg = entry and EntryRegistry.getEntryConfig(entry.name)
    if not cfg or cfg.kind ~= "Unit" then return nil end
    if type(cfg.getRarity) == "function" then
        local ok, rarity = pcall(cfg.getRarity, entry.attributes or {})
        if ok and type(rarity) == "string" then return rarity end
    end
    if type(cfg.rarity) == "string" then return cfg.rarity end
    return nil
end

local function inSet(set, value)
    if type(set) ~= "table" then return false end
    return set[value] == true
end

local function unwrap(getter)
    local ok, result = pcall(function()
        if type(getter) == "function" then return getter() end
        return getter
    end)
    return ok and result or nil
end

--=====================================================================
-- Dropdown source lists
--=====================================================================
local RARITY_LIST = {
    "Common","Uncommon","Rare","Epic","Legendary","Mythical",
    "Exclusive","Exotic","Divine","Celestial","Secret I","Secret II"
}

local CHARACTER_LIST = {}
do
    local entries = EntryRegistry.entriesOfKind("Unit")
    if type(entries) == "table" then
        for name in entries do
            if type(name) == "string" then
                CHARACTER_LIST[#CHARACTER_LIST + 1] = name
            end
        end
        table.sort(CHARACTER_LIST)
    end
end

local ITEM_LIST = {}
do
    local seen = {}
    for _, kind in { "Boost", "Spin", "Token" } do
        local entries = EntryRegistry.entriesOfKind(kind)
        if type(entries) == "table" then
            for name in entries do
                if type(name) == "string"
                    and not seen[name]
                    and not table.find(TradeConfig.UNTRADEABLE_ENTRIES, name)
                then
                    seen[name] = true
                    ITEM_LIST[#ITEM_LIST + 1] = name
                end
            end
        end
    end
    table.sort(ITEM_LIST)
end

