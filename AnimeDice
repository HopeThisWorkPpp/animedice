local function getItemEmoji(name)
    if not name then return "📦" end
    if string.find(name, "Jackpot Spin") then return "🎰" end
    if string.find(name, "Lucky Spin")   then return "🍀" end
    if string.find(name, "Spin")         then return "🎡" end
    if string.find(name, "Gems")         then return "💎" end
    if string.find(name, "Trait Reroll") then return "🎲" end
    if string.find(name, "Grade")        then return "📈" end
    if string.find(name, "Income")       then return "💰" end
    if string.find(name, "Luck")         then return "🍀" end
    if string.find(name, "Coin")         then return "🪙" end
    if string.find(name, "Token")        then return "🎟️" end
    return "📦"
end

local function formatNumber(n)
    local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
    n = tonumber(n) or 0
    if n < 1000 then return tostring(math.floor(n)) end
    local i = 1
    while n >= 1000 and i < #suffixes do
        n = n / 1000
        i = i + 1
    end
    return string.format("%.2f%s", n, suffixes[i])
end

