local function fire(signal, ...)
    if not signal then return false end
    local args = table.pack(...)
    local ok, err = pcall(function()
        signal:Fire(table.unpack(args, 1, args.n))
    end)
    if not ok then warn("[FIRE FAIL] " .. tostring(err)) end
    return ok
end

--=====================================================================
-- Unwrap helpers
--=====================================================================
local function unwrap(v)
    if type(v) == "function" then
        local ok, r = pcall(v); return ok and r or nil
    end
    local mt = type(v) == "table" and getmetatable(v)
    if mt and mt.__call then
        local ok, r = pcall(function() return v() end)
        return ok and r or v
    end
    return v
end

local function deepUnwrap(source)
    local out = {}
    local flat = unwrap(source)
    if type(flat) == "table" then
        for k, v in pairs(flat) do out[k] = v end
    end
    if type(source) == "table" then
        local cached = rawget(source, "___C")
        if type(cached) == "table" then
            for k, v in pairs(cached) do
                if out[k] == nil then
                    local inner = unwrap(v)
                    if inner ~= nil then out[k] = inner end
                end
            end
        end
    end
    return out
end

local function getRarity(entry)
    if type(entry) ~= "table" or not entry.name then return nil end
    local cfg = EntryRegistry.getEntryConfig(entry.name)
    if not cfg then return nil end
    if type(cfg.getRarity) == "function" then
        local ok, r = pcall(cfg.getRarity, entry.attributes or {})
        if ok and type(r) == "string" then return r end
    end
    if type(cfg.rarity) == "string" then return cfg.rarity end
    return nil
end

--=====================================================================
-- HTTP
--=====================================================================
local function httpPost(url, body)
    local headers = { ["Content-Type"] = "application/json" }
    local payload = { Url = url, Method = "POST", Headers = headers, Body = body }

    if typeof(request) == "function" then
        local ok, res = pcall(request, payload)
        if ok and res then return true, res end
    end
    if typeof(http_request) == "function" then
        local ok, res = pcall(http_request, payload)
        if ok and res then return true, res end
    end
    if typeof(http) == "table" and typeof(http.request) == "function" then
        local ok, res = pcall(http.request, payload)
        if ok and res then return true, res end
    end
    return false, "No HTTP library available"
end

