-- Anime Dice Auto-Trade (Full — Gems + Items + All Units)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- ===== CONFIG =====
local TARGET_NAME = "only1Sherifalt1"
local STEP_DELAY = 2
local TRADE_DELAY = 5

local TRADE_LIST = {
    -- Currency & Items
    { Name = "Trait Reroll", Amount = 1    },
    { Name = "Gems",         Amount = 1000 },
    { Name = "Lucky Spin",   Amount = 1    },
    { Name = "Luck Potion",  Amount = 1    },

    -- Units (from wiki)
    { Name = "Hasoka",           Amount = 1 },
    { Name = "Itacha",           Amount = 1 },
    { Name = "Thorfyn",          Amount = 1 },
    { Name = "Arin",             Amount = 1 },
    { Name = "Mikasu",           Amount = 1 },
    { Name = "Mobb",             Amount = 1 },
    { Name = "UI Goko",          Amount = 1 },
    { Name = "Deko",             Amount = 1 },
    { Name = "Bakuga",           Amount = 1 },
    { Name = "Todoraki",         Amount = 1 },
    { Name = "Zaro",             Amount = 1 },
    { Name = "Sakuna",           Amount = 1 },
    { Name = "Madera",           Amount = 1 },
    { Name = "Maheto",           Amount = 1 },
    { Name = "Enol",             Amount = 1 },
    { Name = "Todoh",            Amount = 1 },
    { Name = "Super Saiyen Goko", Amount = 1 },
    -- Add any others from the wiki you want here
}

-- ===== SETUP =====
local TradeService = ReplicatedStorage:WaitForChild("Network")
    :WaitForChild("TradeService"):WaitForChild("RE")

local RequestTrade = TradeService:WaitForChild("RequestTrade")
local ChangeOffer  = TradeService:WaitForChild("ChangeOffer")
local AdvanceTrade = TradeService:WaitForChild("AdvanceTrade")

local function findTarget()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == TARGET_NAME:lower() then return p end
    end
end

local function isTradeOpen()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return false end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextButton") and (d.Text == "Ready" or d.Text == "Decline") then
            return true
        end
    end
    return false
end

local function waitForClose(timeout)
    local t = 0
    while isTradeOpen() and t < timeout do
        task.wait(0.5); t = t + 0.5
    end
    return not isTradeOpen()
end

local function autoTrade(itemName, amount)
    local target = findTarget()
    if not target then
        warn("[TRADE] Alt not in server")
        return false
    end

    if isTradeOpen() then
        print("[TRADE] Waiting for existing trade to close...")
        waitForClose(20)
        task.wait(1)
    end

    print(("[TRADE] %s x%d -> %s"):format(itemName, amount, target.Name))
    RequestTrade:FireServer(target)
    task.wait(STEP_DELAY)

    if not isTradeOpen() then
        warn("[TRADE] Trade window didn't open — alt not accepting?")
        return false
    end

    ChangeOffer:FireServer(itemName, amount)
    task.wait(STEP_DELAY)

    AdvanceTrade:FireServer()
    task.wait(STEP_DELAY)

    if waitForClose(20) then
        print(("[OK] %s x%d sent"):format(itemName, amount))
        return true
    else
        print(("[TIMEOUT] %s didn't complete"):format(itemName))
        return false
    end
end

-- ===== MAIN LOOP =====
print("[START] Target:", TARGET_NAME)
task.wait(3)

for _, entry in ipairs(TRADE_LIST) do
    print(("[LOOP] Trading all %s"):format(entry.Name))
    local count, fails = 0, 0

    while fails < 3 do
        if autoTrade(entry.Name, entry.Amount) then
            count = count + 1
            fails = 0
        else
            fails = fails + 1
            print(("[FAIL] %s — %d/3"):format(entry.Name, fails))
        end
        task.wait(TRADE_DELAY)
    end

    print(("[DONE] %s — %d sent"):format(entry.Name, count))
end

print("[COMPLETE] All done")
