--[[
    Anime Dice Auto-Trade Script
    Path: ReplicatedStorage.Network.TradeService.RE
    Verified args from remote spy
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- ===== REMOTES =====
local Network = ReplicatedStorage:WaitForChild("Network")
local TradeService = Network:WaitForChild("TradeService")
local RE = TradeService:WaitForChild("RE")

local RequestTrade = RE:WaitForChild("RequestTrade")
local ChangeOffer  = RE:WaitForChild("ChangeOffer")
local AdvanceTrade = RE:WaitForChild("AdvanceTrade")
-- RespondToRequest may exist — check with the dump command at the bottom
local RespondToRequest = RE:FindFirstChild("RespondToRequest")

-- ===== CONFIG =====
local TARGET_USERNAME = "Only1sherifalt1"
local STEP_DELAY = 1.5      -- seconds between each remote call
local TRADE_DELAY = 3       -- seconds between full trade attempts

-- Item name -> amount. Use plural "Gems" (as seen in the spy)
-- Check exact item names by running the dump command at the bottom
local TRADE_LIST = {
    { Name = "TraitReroll", Amount = 1    },
    { Name = "Gems",        Amount = 1000 },
    { Name = "LuckySpin",   Amount = 1    },
}

-- ===== FIND TARGET PLAYER =====
local function findTarget()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == TARGET_USERNAME:lower() then
            return p
        end
    end
    return nil
end

-- ===== TRADE FUNCTION =====
local function sendTrade(itemName, amount)
    local target = findTarget()
    if not target then
        warn("[TRADE] Target not in server: " .. TARGET_USERNAME)
        return false
    end

    print(("[TRADE] Sending %s x%d to %s"):format(itemName, amount, target.Name))

    -- Step 1: Request trade
    RequestTrade:FireServer(target)
    task.wait(STEP_DELAY)

    -- Step 2: Add item to offer
    ChangeOffer:FireServer(itemName, amount)
    task.wait(STEP_DELAY)

    -- Step 3: Advance (ready up)
    AdvanceTrade:FireServer()
    task.wait(STEP_DELAY)

    -- Step 4: Advance again (confirm / lock in)
    AdvanceTrade:FireServer()
    task.wait(STEP_DELAY)

    -- Step 5: Advance once more — some trade systems need 3 clicks
    -- Comment out if 2 clicks is enough (watch the trade window to see)
    AdvanceTrade:FireServer()
    task.wait(STEP_DELAY)

    print(("[TRADE] Attempt finished for %s"):format(itemName))
    return true
end

-- ===== MAIN LOOP =====
print("======================================================")
print("[START] Anime Dice Auto-Trade")
print("[START] Target: " .. TARGET_USERNAME)
print("[START] Starting in 5 seconds — make sure alt is in server!")
print("======================================================")
task.wait(5)

for _, entry in ipairs(TRADE_LIST) do
    print(("[LOOP] Trading %s (amount: %d)"):format(entry.Name, entry.Amount))

    local count = 0
    local fails = 0

    while fails < 3 do
        local ok = sendTrade(entry.Name, entry.Amount)
        if ok then
            count = count + 1
            fails = 0
            print(("[SUCCESS] Trade #%d done for %s"):format(count, entry.Name))
        else
            fails = fails + 1
            print(("[FAIL] Attempt %d failed"):format(fails))
        end
        task.wait(TRADE_DELAY)
    end

    print(("[DONE] Finished %s — %d trades sent"):format(entry.Name, count))
end

print("[COMPLETE] All trades finished!")
