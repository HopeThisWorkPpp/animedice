-- MAIN
--=====================================================================
local target = findTarget()
if not target then
    warn("[ERROR] Target not found: " .. TARGET_NAME)
    return
end

print("[MAIN] Step 1: Picking up matching units from plot...")
local picked = pickupPlacedUnits()
print(("[MAIN] Picked up %d unit(s)"):format(picked))

print("[MAIN] Step 2: Building offer plan...")
local plan = buildOffer()
print(("[MAIN] %d entries planned"):format(#plan))
if #plan == 0 then
    warn("[ERROR] Nothing to trade")
    return
end

if WEBHOOK_ON_START then
    print("[MAIN] Sending pre-trade webhook...")
    pcall(sendInventoryWebhook, "Pre-Trade")
end

print("[MAIN] Step 3: Requesting trade with " .. target.Name)
fire(RequestTrade, target)

local startDeadline = os.clock() + 10
while not trade.active and os.clock() < startDeadline do task.wait(0.1) end
if not trade.active then
    warn("[ERROR] Trade did not start — did the alt accept?")
    return
end
print("[MAIN] Trade started")

print("[MAIN] Step 4: Pushing offer...")
local synced = waitForOfferSync(plan, 20)
if not synced then
    warn("[ERROR] Offer never matched")
    fire(CancelTrade)
    return
end

print("[MAIN] Offer matches. Waiting for settle...")
task.wait(OFFER_SETTLE_WAIT)

if not offerMatchesPlan(plan) then
    warn("[MAIN] Offer changed after settle — re-syncing")
    if not waitForOfferSync(plan, 10) then
        warn("[ERROR] Server keeps rejecting part of the offer")
        fire(CancelTrade)
        return
    end
end

print("[MAIN] Step 5: Readying up")
holdReady()

print("[MAIN] Step 6: Waiting for partner ready...")
local partnerDeadline = os.clock() + 60
while not trade.otherReady and os.clock() < partnerDeadline do
    if not trade.ownReady and trade.phase ~= "Confirm" then
        holdReady()
    end
    task.wait(0.3)
end

if trade.phase == "Confirm" then
    print("[MAIN] Phase is Confirm — confirming")
    for _ = 1, READY_MAX_RETRIES do
        if trade.ownAccepted then break end
        fire(AdvanceTrade)
        task.wait(0.5)
    end
end

print("[DONE] Trade complete")

if WEBHOOK_ON_END then
    task.wait(2)
    print("[MAIN] Sending post-trade webhook...")
    pcall(sendInventoryWebhook, "Post-Trade")
end
