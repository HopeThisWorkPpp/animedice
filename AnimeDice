    if d:IsA("TextButton") and d.Visible and d.Text ~= "" then
        if not seen[d.Text] then
            seen[d.Text] = true
            print("  [BTN]", d.Text, "| Path:", d:GetFullName())
        end
    end
end
print("═══════════════════════════════════════")

-- ===== MAIN LOOP =====
print("[START] Trading all items")
for _, entry in ipairs(ITEMS_TO_TRADE) do
    print(("[LOOP] %s"):format(entry.Name))
    local count, fails = 0, 0
    while fails < 3 do
        if doTrade(entry.Name, entry.Amount) then
            count = count + 1; fails = 0
        else
            fails = fails + 1
        end
        task.wait(TRADE_DELAY)
    end
    print(("[DONE] %s — %d sent"):format(entry.Name, count))
end
print("[COMPLETE]")
