local function unwrap(v)
    if type(v) == "function" then
        local ok, r = pcall(v); return ok and r or nil
    end
    local mt = type(v) == "table" and getmetatable(v)
    if mt and mt.__call then
        local ok, r = pcall(function() return v() end)
        return ok and r or v
    end
    return v
end

local function deepUnwrap(source)
    local out = {}
    local flat = unwrap(source)
    if type(flat) == "table" then
        for k, v in pairs(flat) do out[k] = v end
    end
    if type(source) == "table" then
        local cached = rawget(source, "___C")
        if type(cached) == "table" then
            for k, v in pairs(cached) do
                if out[k] == nil then
                    local inner = unwrap(v)
                    if inner ~= nil then out[k] = inner end
                end
            end
        end
    end
    return out
end

local function getRarity(entry)
    if type(entry) ~= "table" or not entry.name then return nil end
    local cfg = EntryRegistry.getEntryConfig(entry.name)
    if not cfg then return nil end
    if type(cfg.getRarity) == "function" then
        local ok, r = pcall(cfg.getRarity, entry.attributes or {})
        if ok and type(r) == "string" then return r end
    end
    if type(cfg.rarity) == "string" then return cfg.rarity end
    return nil
end

local function fmtNum(n)
    local s = { "","K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc" }
    n = tonumber(n) or 0
    if n < 1000 then return tostring(math.floor(n)) end
    local i = 1
    while n >= 1000 and i < #s do n = n / 1000; i = i + 1 end
    return string.format("%.2f%s", n, s[i])
end

local function itemTag(name)
    if not name then return "[ITEM]" end
    if string.find(name, "Jackpot Spin") then return "[JACKPOT]" end
    if string.find(name, "Lucky Spin")   then return "[LUCKY]" end
    if string.find(name, "Spin")         then return "[SPIN]" end
    if string.find(name, "Gems")         then return "[GEMS]" end
    if string.find(name, "Trait Reroll") then return "[TRAIT]" end
    if string.find(name, "Grade")        then return "[GRADE]" end
    if string.find(name, "Income")       then return "[INCOME]" end
    if string.find(name, "Luck")         then return "[LUCK]" end
    return "[ITEM]"
end

